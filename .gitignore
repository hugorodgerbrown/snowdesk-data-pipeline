# Stray tox environments in the repository root. `toxworkdir` normally puts
# these under .tox/, but a mis-set one writes a virtualenv named after each
# tox env straight into the root instead — four of them (2 GB) accumulated
# unnoticed, and because they are trees of third-party source they broke
# `makemessages` and slowed every tool that walks the tree. Anchored with a
# leading slash: a bare `test` or `lint` would match those names anywhere.
# Generated from tox.ini's [testenv:*] sections — add a line when a new env
# is added there.
/audit/
/audit-dev/
/django-checks/
/djangofmt/
/docs-lint/
/ds-lint/
/e2e/
/e2e-lint/
/fmt/
/i18n-lint/
/js/
/js-globals-lint/
/lint/
/migrations-lint/
/mypy/
/sast/
/test/

# Tailwind CLI build output (regenerated from static/css/main.css)
static/css/output.css

# Django
db.sqlite3
# Backups taken before a reseed (docs/worktrees.md's force-reseed procedure
# renames the old DB aside rather than deleting it). `db.sqlite3` alone does
# not match these, so without this line a 69 MB dev database is one
# `git add -A` away from the index.
db.sqlite3.bak-*
# Playwright e2e file-based test database (tox -e e2e) + its journal/WAL files
e2e_test_db.sqlite3*
*.log
*.log.*
logs/*.log
logs/*.log.*
staticfiles/
mediafiles/

# Keep the logs directory
!logs/.gitkeep

# Coverage
htmlcov/
.coverage

# Lighthouse CI
.lighthouseci/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Compiled message catalogues (regenerated by compilemessages)
*.mo

# OS
.DS_Store
Thumbs.db

# Secrets — Web Push VAPID keypair (raw scalar in .key; PEM only for inspection)
*.pem
*.key
.vapid-private.*

# GeoIP database files — downloaded by bin/fetch-geoip-data; not committed
reference_data/geoip/*.mmdb

# pen.dev design canvas — a local design scratch file, not a project artefact.
# It carries a `fileToken` document UUID that trips the gitleaks generic-api-key
# rule (SNOW-599); keep it out of history rather than allowlisting new copies.
design-canvas.pen

# SNOW-622: source maps emitted beside the minified JS by `bin/minify-js`,
# which runs on deploy and before a Lighthouse run. Never committed — the
# sources they map back to are the tracked files themselves.
static/js/*.js.map
