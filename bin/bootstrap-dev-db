#!/usr/bin/env bash
# bin/bootstrap-dev-db — Seed a fresh local development database.
#
# Runs migrations, loads all region and resort fixtures, and fetches bulletins
# from all three providers via the local mirrors, all against the local DB
# defined in your .env.
#
# PREREQUISITE: the Django dev server must be running on :8000 before you
# execute this script. The SLF and ALBINA local mirrors are
# served by dev-only views in the running server; Météo-France reads a local
# directory and does not need the server, but it does need a configured
# METEOFRANCE_API_KEY (or the local-mirror path) in your .env.
#
# Usage:
#   uv run python manage.py runserver &   # in another terminal
#   ./bin/bootstrap-dev-db
#
# Fully-offline alternative (no server required):
#   uv run python manage.py loaddata eaws_CH resorts
#   uv run python manage.py seed_test_data --all --commit
# That builds the navigable test dataset (Martigny-Verbier for April 2026,
# plus map-coverage bulletins) from the factories and is suitable for most UI work.

set -o errexit

echo "==> Applying migrations …"
uv run python manage.py migrate

echo "==> Loading region and resort fixtures …"
uv run python manage.py loaddata \
    apps/regions/fixtures/eaws_CH.json \
    apps/regions/fixtures/eaws_FR.json \
    apps/regions/fixtures/eaws_AT.json \
    apps/regions/fixtures/eaws_IT.json \
    apps/regions/fixtures/resorts.json

echo "==> Fetching bulletins from all providers (local mirror) …"
uv run python manage.py fetch_bulletins \
    --source slf albina meteofrance \
    --local-mirror \
    --commit

echo ""
echo "Bootstrap complete. Open a bulletin page to verify:"
# Fixed canonical date — the local mirrors cover April 2026, so today's host
# date would usually 404. CH-4115 has full detail for this day (see
# docs/management-commands.md).
echo "  http://localhost:8000/ch-4115/martigny-verbier/2026-04-08/"
