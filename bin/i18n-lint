#!/usr/bin/env python3
# bin/i18n-lint — Catch user-facing strings hardcoded in JavaScript (SNOW-620).
#
# `makemessages` scans templates and Python. It does not scan JavaScript, so
# a string written as a JS literal never reaches the message catalogue and
# ships as English to every locale no matter how complete that locale is.
# Roughly forty of them had accumulated across eight modules — the whole
# layers-menu sync dashboard, every mutation and favourite failure toast,
# the update banner, and all the timelapse controls. Findings C4 and M15 in
# docs/code-reviews/2026-08-03-js-review.md.
#
# Nothing would have caught it, and nothing would stop it recurring: the
# split was already visible before this check existed, with the downloads
# sheet translating one removal-failure message while `favourites.js`
# hardcoded its near-twin.
#
# So this checks one thing: a string LITERAL reaching a sink the user reads
# — DIRECTLY, or through one hop of variable indirection (`const text =
# {…}[state]; el.setAttribute('aria-label', text);`). The fix is always
# the same — render it through a strings `<template>` and read it back
# with `window.pwaStrings.read()` (static/js/i18n_strings.js).
#
# SNOW-645 review widened the direct-literal check (SNOW-620's own scope)
# to that one hop, closing the exact gap seven of map_region_download.js's
# eight roundel labels shipped through for as long as this file has
# existed: `SINK_RE`'s value group sits directly against the sink, so a
# BARE IDENTIFIER carrying an already-built string was invisible to it.
# `INDIRECT_SINK_RE`/`_traces_to_prose` add exactly that one hop — the
# NEAREST preceding declaration of that identifier, never further back —
# and stop there. A two-hop chain, a value read off `this`/a closure
# variable from an outer scope, or a literal folded in through a function
# call, are all still out of scope: catching those needs real dataflow,
# and the false-positive rate would make the check ignorable, which is
# worse than not having it. Still deliberately narrow, for the same reason
# `bin/js-globals-lint` is.
#
# Escape hatch, for a string that genuinely should not be translated:
#
#     // i18n-allow: <reason>
#     el.textContent = 'GPS';
#
# The reason is required and audit-visible (`bin/i18n-lint --show-allows`) —
# write it for a reviewer judging it cold. Staff-only surfaces are the main
# legitimate use: `map_edit_resorts.js` and `push_demo.js` are never shown
# to a member of the public.
#
# Exit code: 0 = clean; 1 = one or more untranslatable strings.
#
# Usage:
#   bin/i18n-lint                    # scan static/js
#   bin/i18n-lint path/to/file.js …  # scan specific files
#   bin/i18n-lint --show-allows      # print every suppression and its reason
"""Hardcoded-user-string linter for first-party JavaScript — see module docstring."""

# ruff: noqa: T201
# CLI script — print() is the intended output channel.

from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
JS_ROOT = REPO_ROOT / "static" / "js"

# Vendored bundles — not ours to translate. Named individually rather than
# by a `*.min.js` glob so vendoring a new file is a deliberate act that
# shows up in review. Mirrors `bin/js-globals-lint`.
VENDORED: frozenset[str] = frozenset(
    {
        "htmx.min.js",
        "maplibre-gl.min.js",
    }
)

# Sinks a string literal reaches the user through. Each alternative ends
# just before the literal, which the `value` group then captures.
#
# `innerHTML` is included even though this codebase mostly builds DOM
# nodes: `report.js` assembles its ineligible-user states by concatenation.
SINKS = r"""
      \.textContent \s* (?:\+?=)
    | \.innerText \s* (?:\+?=)
    | \.innerHTML \s* (?:\+?=)
    | \.title \s* =
    | \.alt \s* =
    | \.placeholder \s* =
    | \.ariaLabel \s* =
    | setAttribute \( \s* ['"] (?: aria-label | aria-valuetext | title
                                 | placeholder | alt ) ['"] \s* ,
"""

# A quoted literal — single, double or backtick — with at least two letters
# in it somewhere. The letter requirement is what keeps out the enormous
# volume of non-prose strings these modules assign: ids, class names,
# dataset keys, '', '×', ' / '.
STRING_LITERAL = r"""
    \s* (?P<quote>['"`])
    (?P<value> (?: (?! (?P=quote) ) [^\\] | \\. ){1,300}? )
    (?P=quote)
"""

SINK_RE = re.compile(f"(?:{SINKS}){STRING_LITERAL}", re.X)

# SNOW-645 review: the sink reached through ONE HOP of variable
# indirection — `const text = {…}[state]; el.setAttribute('aria-label',
# text);` — which SINK_RE above cannot see, because its value group sits
# directly against the sink and a bare identifier is not a literal.
# `map_region_download.js`'s `setState` shipped seven strings this way for
# as long as bin/i18n-lint has existed, and would have shipped an eighth
# in this same PR were this not added.
#
# Deliberately narrow rather than general dataflow: only a BARE
# identifier (`text`, not `S.reload` or `MAP_STRINGS['x']`) is a
# candidate at all, and `_traces_to_prose` below only follows it to the
# NEAREST preceding `const`/`let`/`var` declaration or bare reassignment
# of that exact name — see that function's own docstring for why a
# member-expression value is out of scope by construction, not merely
# unhandled.
INDIRECT_SINK_RE = re.compile(
    rf"(?:{SINKS})\s*(?P<ident>[A-Za-z_$][\w$]*)\s*(?=[,);])",
    re.X,
)

# A prose literal in VALUE POSITION — immediately after a plain `=`
# (never `==`/`===`/`!=`/`<=`/`>=`, excluded by the lookbehind/lookahead),
# a ternary `?`, or a ternary/object-property `:` (never `::`). This is
# what lets `_traces_to_prose` tell "Reload" in
# `const label = MAP_STRINGS['x'] || 'Reload'` (not adjacent to any of
# these — `||` isn't a value-position operator) from "Reload" in
# `const label = saving ? 'Reload' : X` (adjacent to `?`) — the former is
# a translated lookup with an English constant as a fallback KEY NAME
# component, never reached; the latter is the untranslated message
# itself. It is also what keeps a `.join(' &middot; ')` separator quiet:
# preceded by `(`, not one of these three operators.
VALUE_LITERAL_RE = re.compile(
    rf"""
      (?: (?<! [=!<>] ) = (?! = )
        | \?
        | : (?! : )
      )
    {STRING_LITERAL}
    """,
    re.X,
)

# How far back (lines) to search for the declaration/assignment that fed
# a bare-identifier sink value — generous enough to span map_region_download.js's
# `setState` (its `text` object is the longest instance of this shape in
# the tree today, at under 30 lines), bounded so an unrelated same-named
# variable in a much earlier, unconnected scope can't be mistaken for it.
INDIRECTION_WINDOW = 80

# `const NAME = …` / `let NAME = …` / `var NAME = …`, or a bare
# reassignment `NAME = …` — either can be the start of the span
# `_traces_to_prose` walks. Anchored at the START of the line (allowing
# leading whitespace only): a property `text: 'foo'` or a function
# parameter `text` never matches either, which is what keeps those two
# shapes out of scope — see `_traces_to_prose`'s own docstring.
DECL_RE = re.compile(r"^\s*(?:const|let|var)\s+(?P<name>[A-Za-z_$][\w$]*)\b")
REASSIGN_RE = re.compile(r"^\s*(?P<name>[A-Za-z_$][\w$]*)\s*=(?!=)")

# A span containing any of these already sources its strings through the
# translated route — see `map_state.js`'s MAP_STRINGS or
# `i18n_strings.js`'s `pwaStrings.read`/`interpolate` for the two forms in
# use today. Matches even when the span ALSO happens to contain prose (a
# `pwaStrings.read` fallback object's own English defaults, say) — this
# check is deliberately a broad "already translated" signal, not a
# precise one, in keeping with the under-report bias below.
SAFE_SOURCE_RE = re.compile(r"pwaStrings\.(?:read|interpolate)\(|MAP_STRINGS(?:\[|\.)")

# Prose needs two consecutive letters somewhere, and at least one space OR
# a capitalised word — "Reload" and "Sign in" are prose; "flex", "px-2",
# "true" and "region-tooltip-date" are not.
#
# This is the one heuristic in the check, and it is tuned to under-report:
# a missed string is a string that was already invisible, while a false
# positive is a demand to add a suppression to code that never needed one.
PROSE_RE = re.compile(r"[A-Za-z]{2}")
NOT_PROSE_RE = re.compile(
    r"""
      ^[a-z0-9]+(?:[-_][a-z0-9]+)*$        # kebab/snake token: data keys, ids
    | ^[A-Z0-9_]+$                          # SCREAMING_CASE constant
    | ^[\d\s.,:/×+-]*$                      # punctuation and numbers only
    | ^(?:true|false|null|undefined)$
    | ^\s*<                                 # a markup fragment, not a sentence
    | ^%\(\w+\)s$                           # a bare placeholder
    """,
    re.X,
)

# Template-literal interpolations. Stripped before the prose test: what
# matters is the LITERAL text a translator would be given, not the values
# substituted into it. `` `${digit}${subdivision}` `` is pure data and has
# nothing to translate; `` `${set} / ${total} set` `` has the word "set" in
# it and does.
INTERPOLATION_RE = re.compile(r"\$\{[^}]*\}")

# `// i18n-allow: <reason>` on the line before, or trailing the line itself.
ALLOW_RE = re.compile(r"//\s*i18n-allow:\s*(?P<reason>\S.*?)\s*$")

# Wholly-comment lines. Prose in a header comment is documentation.
COMMENT_RE = re.compile(r"^\s*(?://|\*|/\*)")


@dataclass(frozen=True)
class Finding:
    """One hardcoded string reaching a user-visible sink."""

    path: Path
    line_no: int
    line_text: str
    value: str


@dataclass(frozen=True)
class Suppression:
    """One `i18n-allow` and the reason given for it."""

    path: Path
    line_no: int
    reason: str


def _repo_relative(path: Path) -> Path:
    """Return `path` relative to `REPO_ROOT`, or unchanged if outside it.

    The CLI accepts arbitrary paths — a fixture under `/tmp`, an ad-hoc
    invocation — so a path outside the repo must format rather than raise.
    Mirrors `bin/ds-lint` and `bin/js-globals-lint`.
    """
    try:
        return path.relative_to(REPO_ROOT)
    except ValueError:
        return path


def _js_files(args_paths: list[str]) -> list[Path]:
    """Resolve CLI args to the concrete list of first-party .js files."""
    paths: list[Path] = []
    if args_paths:
        for raw in args_paths:
            p = Path(raw).resolve()
            if p.is_dir():
                paths.extend(sorted(p.rglob("*.js")))
            elif p.suffix == ".js" and p.exists():
                paths.append(p)
    elif JS_ROOT.exists():
        paths.extend(sorted(JS_ROOT.rglob("*.js")))
    return [p for p in paths if p.name not in VENDORED]


def _is_prose(value: str) -> bool:
    """Report whether `value` reads as human copy rather than a machine token."""
    text = INTERPOLATION_RE.sub("", value).strip()
    if not text or not PROSE_RE.search(text):
        return False
    return not NOT_PROSE_RE.match(text)


def _suppressed(lines: list[str], idx: int) -> bool:
    """Report whether line `idx` (0-based) carries or follows an `i18n-allow`.

    Walks back over the whole contiguous comment block above the line, not
    just the single line before it. A reason worth writing usually does not
    fit in the remaining columns of one line, and requiring it to would
    push authors towards reasons short enough to be useless.
    """
    if ALLOW_RE.search(lines[idx]):
        return True
    for prev in range(idx - 1, -1, -1):
        if not COMMENT_RE.match(lines[prev]):
            return False
        if ALLOW_RE.search(lines[prev]):
            return True
    return False


def _nearest_declaration(lines: list[str], sink_idx: int, ident: str) -> int | None:
    """Find the line index of the NEAREST declaration/reassignment of `ident`.

    Searched backward from `sink_idx`, within `INDIRECTION_WINDOW` lines —
    see that constant's own comment for why a bounded, nearest-match
    search is the right trade-off rather than a full scope analysis.

    @returns The 0-based line index, or None if nothing matched — a
        variable declared in a DIFFERENT file, a function parameter (never
        matches `DECL_RE`/`REASSIGN_RE`, both anchored at line-start), or
        simply out of range.
    """
    floor = max(-1, sink_idx - INDIRECTION_WINDOW)
    for idx in range(sink_idx, floor, -1):
        match = DECL_RE.match(lines[idx]) or REASSIGN_RE.match(lines[idx])
        if match and match.group("name") == ident:
            return idx
    return None


def _statement_end(lines: list[str], start: int) -> int:
    """Find the line index where the statement opened at `start` closes.

    Tracks `{`/`}` depth per line (a `${…}` template interpolation on one
    line nets to zero, which is the only nesting shape this codebase's
    label objects actually use) and calls the statement closed on the
    first line, at or after `start`, where that depth is back to zero AND
    a `;` appears — covering both a single-line assignment (no braces at
    all, so depth is zero throughout) and a multi-line one whose last
    brace and trailing `;` share a line. Bounded by `INDIRECTION_WINDOW`
    for the same reason `_nearest_declaration`'s search is.
    """
    depth = 0
    ceiling = min(len(lines), start + INDIRECTION_WINDOW)
    for idx in range(start, ceiling):
        line = lines[idx]
        depth += line.count("{") - line.count("}")
        if depth <= 0 and ";" in line:
            return idx
    return ceiling - 1


def _traces_to_prose(
    lines: list[str], sink_idx: int, ident: str
) -> list[tuple[int, str]]:
    """Find untranslated literals reaching `sink_idx` through `ident`'s declaration.

    Deliberately ONE hop: only `ident`'s NEAREST preceding declaration is
    read, never wherever ITS OWN value came from. A member-expression
    value (`S.reload`, `MAP_STRINGS['x']`) is out of scope by
    construction — `INDIRECT_SINK_RE` only captures a BARE identifier —
    and so is a function parameter, since `DECL_RE`/`REASSIGN_RE` are both
    anchored at the start of a line and a parameter list never is. Both
    exclusions are the same "under-report a two-hop or opaque case rather
    than risk a false positive" choice `_is_prose`'s own comment makes.

    @returns `[(line_index, value), …]` for every prose literal found in
        VALUE POSITION across the declaration's own statement — empty if
        `ident` traces to no declaration in range, or the span is already
        sourced from `pwaStrings`/`MAP_STRINGS` (see `SAFE_SOURCE_RE`).
    """
    start = _nearest_declaration(lines, sink_idx, ident)
    if start is None:
        return []
    end = _statement_end(lines, start)
    span = "\n".join(lines[start : end + 1])
    if SAFE_SOURCE_RE.search(span):
        return []

    found: list[tuple[int, str]] = []
    for idx in range(start, end + 1):
        if COMMENT_RE.match(lines[idx]):
            continue
        for hit in VALUE_LITERAL_RE.finditer(lines[idx]):
            value = hit.group("value")
            if _is_prose(value):
                found.append((idx, value))
    return found


def _direct_findings(
    path: Path, lines: list[str], idx: int, raw_line: str
) -> list[Finding]:
    """Find findings in `raw_line` where a literal sits DIRECTLY against a sink."""
    findings = []
    for hit in SINK_RE.finditer(raw_line):
        value = hit.group("value")
        if not _is_prose(value) or _suppressed(lines, idx):
            continue
        findings.append(
            Finding(
                path=path, line_no=idx + 1, line_text=raw_line.rstrip(), value=value
            )
        )
    return findings


def _indirect_findings(
    path: Path,
    lines: list[str],
    idx: int,
    raw_line: str,
    traced_declarations: set[int],
) -> list[Finding]:
    """Find findings where a sink's value is a bare, traceable identifier.

    `traced_declarations` is mutated as a side effect — shared across the
    whole file scan, so a declaration read by several sinks in a row (see
    `_scan`'s own comment) is only ever traced once.
    """
    findings = []
    for hit in INDIRECT_SINK_RE.finditer(raw_line):
        ident = hit.group("ident")
        start = _nearest_declaration(lines, idx, ident)
        if start is None or start in traced_declarations:
            continue
        traced_declarations.add(start)
        for lit_idx, value in _traces_to_prose(lines, idx, ident):
            if _suppressed(lines, lit_idx):
                continue
            findings.append(
                Finding(
                    path=path,
                    line_no=lit_idx + 1,
                    line_text=lines[lit_idx].rstrip(),
                    value=value,
                )
            )
    return findings


def _scan(path: Path) -> tuple[list[Finding], list[Suppression]]:
    """Find hardcoded user strings in `path`, and the suppressions used."""
    findings: list[Finding] = []
    suppressions: list[Suppression] = []
    lines = path.read_text(encoding="utf-8").splitlines()
    # One finding per DECLARATION, not per sink call site — `setState`-style
    # code reads the same object through two or three sinks in a row
    # (`setAttribute('aria-label', text); btn.title = text;`), and without
    # this every prose literal inside it would be reported once per sink.
    traced_declarations: set[int] = set()

    for idx, raw_line in enumerate(lines):
        match = ALLOW_RE.search(raw_line)
        if match:
            suppressions.append(
                Suppression(path=path, line_no=idx + 1, reason=match.group("reason"))
            )
        if COMMENT_RE.match(raw_line):
            continue
        findings.extend(_direct_findings(path, lines, idx, raw_line))
        findings.extend(
            _indirect_findings(path, lines, idx, raw_line, traced_declarations)
        )
    return findings, suppressions


def _report(findings: list[Finding]) -> None:
    """Print each finding in the `path:line: [rule] snippet` house format."""
    for finding in findings:
        rel = _repo_relative(finding.path)
        snippet = finding.line_text.strip()
        if len(snippet) > 100:
            snippet = snippet[:97] + "..."
        print(f"{rel}:{finding.line_no}: [hardcoded-string] {snippet}")
        print(
            f'    → "{finding.value}" is written into the DOM as a JS literal, '
            f"so makemessages cannot see it and it will ship as English to "
            f"every locale. Render it in the surface's strings <template> and "
            f"read it back with window.pwaStrings.read() — see "
            f"static/js/i18n_strings.js. If it genuinely should not be "
            f"translated (a staff-only surface, a protocol token), add "
            f"`// i18n-allow: <reason>` on the line before."
        )


def main() -> int:
    """CLI entry point — see module docstring for behaviour and exit codes."""
    parser = argparse.ArgumentParser(
        description="Fail on user-facing strings hardcoded in JavaScript.",
    )
    parser.add_argument("paths", nargs="*", help="Files/dirs. Defaults to static/js.")
    parser.add_argument(
        "--show-allows",
        action="store_true",
        help="Print every i18n-allow suppression and its reason (audit aid).",
    )
    args = parser.parse_args()

    findings: list[Finding] = []
    suppressions: list[Suppression] = []
    for path in _js_files(args.paths):
        file_findings, file_suppressions = _scan(path)
        findings.extend(file_findings)
        suppressions.extend(file_suppressions)

    if args.show_allows:
        print("i18n-allow suppressions:")
        for s in suppressions:
            print(f"  {_repo_relative(s.path)}:{s.line_no}: {s.reason}")
        if not suppressions:
            print("  (none)")
        print()

    _report(findings)

    if findings:
        print(f"\n{len(findings)} hardcoded user-facing string(s).")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
