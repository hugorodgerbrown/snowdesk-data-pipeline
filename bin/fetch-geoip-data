#!/usr/bin/env bash
# bin/fetch-geoip-data — Download GeoLite2-City.mmdb from MaxMind.
#
# Downloads the MaxMind GeoLite2-City binary database and installs it at
# data/geoip/GeoLite2-City.mmdb.  Idempotent — re-running replaces the file
# with the latest build.
#
# GeoIP is a best-effort enrichment: ``bulletins.services.geoip.geo_lookup``
# returns ``None`` for every caller when the database is absent, so the app
# boots and serves fine without it (only RequestLog geo fields go empty).
# The download must therefore NEVER block a deploy — a transient MaxMind
# outage or rate-limit is not a reason to fail the whole build.
#
# Required environment variables:
#   MAXMIND_ACCOUNT_ID   Your MaxMind account ID (numeric).
#   MAXMIND_LICENSE_KEY  Your MaxMind licence key.
#
# Exit behaviour (always exits 0 — GeoIP is optional, see above):
#   - Credentials unset → warn and exit 0 (local dev without an account boots
#     fine; geo fields will be empty).
#   - Download succeeds → install the database and exit 0.
#   - Download fails → reuse the existing on-disk database if present,
#     otherwise warn loudly and exit 0 with GeoIP disabled.
#
# Retry policy: a 429 rate-limit is NEVER retried — the free-tier cap (30
# downloads per 24h, per account) won't clear inside a build window, so
# waiting is pointless; skip straight to fallback. A 5xx / network error gets
# ONE immediate retry (a transient server hiccup may clear at once), then
# gives up. Either way a failed download degrades to GeoIP-disabled — it never
# fails the deploy. Only the web service runs this (via build.sh); the
# scheduler/worker build with build_headless.sh and never fetch GeoIP.
#
# Usage:
#   ./bin/fetch-geoip-data
#
# Setup (one-time):
#   1. Sign up for a free MaxMind account at https://www.maxmind.com/en/geolite2/signup
#   2. Generate a licence key at https://www.maxmind.com/en/accounts/current/license-key
#   3. Set MAXMIND_ACCOUNT_ID and MAXMIND_LICENSE_KEY in your .env or CI secrets.

set -euo pipefail

DEST_DIR="$(cd "$(dirname "$0")/../data/geoip" && pwd)"
DEST_FILE="${DEST_DIR}/GeoLite2-City.mmdb"
DOWNLOAD_URL="https://download.maxmind.com/geoip/databases/GeoLite2-City/download?suffix=tar.gz"

# ---------------------------------------------------------------------------
# Credential guard — no-op if credentials are absent
# ---------------------------------------------------------------------------

ACCOUNT_ID="${MAXMIND_ACCOUNT_ID:-}"
LICENSE_KEY="${MAXMIND_LICENSE_KEY:-}"

if [[ -z "${ACCOUNT_ID}" || -z "${LICENSE_KEY}" ]]; then
    echo "fetch-geoip-data: MAXMIND_ACCOUNT_ID or MAXMIND_LICENSE_KEY is unset — skipping download" >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# Download (single 5xx/network retry; 429 and other errors skip straight to
# fallback)
# ---------------------------------------------------------------------------

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "${WORK_DIR}"' EXIT

ARCHIVE="${WORK_DIR}/GeoLite2-City.tar.gz"

_is_server_error() {
    # True for a transient server-side / network failure worth ONE immediate
    # retry: 5xx, or a curl network failure (curl writes 000 to %{http_code}
    # when it got no HTTP response at all — DNS/connection/timeout). A 429 is
    # deliberately NOT here: a rate-limit won't clear inside the build, so
    # retrying is pointless.
    case "${1}" in
        500 | 502 | 503 | 504 | 000 | "") return 0 ;;
        *) return 1 ;;
    esac
}

_download_ok() {
    # Attempt one download into ${ARCHIVE}. Returns 0 on a usable gzip
    # archive; otherwise echoes the observed HTTP status on stdout and
    # returns 1 so the caller can decide whether to retry.
    #
    # --location follows MaxMind's 302 to the CDN that serves the archive.
    # Without it curl writes the redirect-response body (empty / HTML stub)
    # to ${ARCHIVE} and exits 0, and tar then fails on a non-archive file.
    # -w surfaces the final HTTP status so build-log readers can diagnose.
    local http_code
    http_code="$(curl --location --silent --show-error \
            --user "${ACCOUNT_ID}:${LICENSE_KEY}" \
            --output "${ARCHIVE}" \
            --write-out "%{http_code}" \
            "${DOWNLOAD_URL}" || true)"

    if [[ "${http_code}" != "200" ]]; then
        echo "${http_code}"
        return 1
    fi

    # Sanity-check the archive is actually gzip (magic bytes 1f 8b) before
    # handing it to tar. A passing HTTP 200 is not enough — a misconfigured
    # auth or proxy can still serve a plaintext error page with status 200.
    if [[ ! -s "${ARCHIVE}" ]] || ! gzip --test "${ARCHIVE}" >/dev/null 2>&1; then
        local bytes first
        bytes="$(wc -c < "${ARCHIVE}" | tr -d ' ')"
        first="$(head -c 120 "${ARCHIVE}" 2>/dev/null | tr -d '\0' || true)"
        echo "fetch-geoip-data: archive is not a valid gzip stream (${bytes} bytes)" >&2
        echo "fetch-geoip-data: first bytes: ${first}" >&2
        echo "200-invalid"
        return 1
    fi

    return 0
}

_fallback_or_skip() {
    # Called when the download is unusable. Reuses the existing on-disk
    # database if present (Render persists the working directory between
    # deploys on the same instance), otherwise leaves GeoIP disabled — but
    # never fails the build (geo is optional).
    if [[ -f "${DEST_FILE}" ]]; then
        echo "fetch-geoip-data: reusing existing database at ${DEST_FILE}" >&2
        exit 0
    fi
    echo "fetch-geoip-data: no database available — continuing with GeoIP disabled (geo fields will be empty)" >&2
    exit 0
}

echo "fetch-geoip-data: downloading GeoLite2-City from MaxMind…"

if ! status="$(_download_ok)"; then
    echo "fetch-geoip-data: download failed (HTTP ${status:-unknown})" >&2

    # A 429 or any non-server error is not worth retrying — fall back now.
    # A 5xx / network blip gets exactly one immediate retry.
    if ! _is_server_error "${status}"; then
        _fallback_or_skip
    fi

    echo "fetch-geoip-data: transient server error — retrying once…" >&2
    if ! status="$(_download_ok)"; then
        echo "fetch-geoip-data: retry failed (HTTP ${status:-unknown})" >&2
        _fallback_or_skip
    fi
fi

# ---------------------------------------------------------------------------
# Extract
# ---------------------------------------------------------------------------

tar --extract \
    --file="${ARCHIVE}" \
    --directory="${WORK_DIR}" \
    --wildcards \
    --no-anchored \
    "*.mmdb"

# The tarball unpacks to GeoLite2-City_YYYYMMDD/GeoLite2-City.mmdb — find it.
EXTRACTED_MMDB="$(find "${WORK_DIR}" -name "GeoLite2-City.mmdb" | head -1)"

if [[ -z "${EXTRACTED_MMDB}" ]]; then
    echo "fetch-geoip-data: GeoLite2-City.mmdb not found in archive" >&2
    _fallback_or_skip
fi

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

mkdir -p "${DEST_DIR}"
cp "${EXTRACTED_MMDB}" "${DEST_FILE}"

echo "fetch-geoip-data: installed GeoLite2-City.mmdb at ${DEST_FILE}"
