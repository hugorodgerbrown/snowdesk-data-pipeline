.refresh { font: inherit; font-size: 13px; font-weight: 600; color: var(--fg); background: var(--card); border: 1px solid var(--line-strong); border-radius: 999px; padding: 5px 14px; cursor: pointer; }
.refresh:hover { border-color: var(--accent); color: var(--accent); }
.refresh:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.refresh[disabled] { cursor: progress; opacity: 0.6; }
.live-note { font-size: 13px; color: var(--fg-2); font-variant-numeric: tabular-nums; }
.live-note.warn { color: var(--drop); }
.plain .status:empty { display: none; }
.plain .status { font-size: 11px; padding: 1px 7px; border-radius: 999px; background: var(--tag); color: var(--fg); }
.closed .item-title, .closed strong { text-decoration: line-through; text-decoration-color: var(--fg-2); }
.closed .why { opacity: 0.7; }
.closed .status { background: var(--ship-bg) !important; color: var(--ship) !important; }
.changed .status { outline: 2px solid var(--accent); outline-offset: 1px; }
@media (prefers-reduced-motion: no-preference) { .changed .status { transition: outline-color 0.4s; } }
</style>"""


# The Refresh button. Reads Linear through the viewer's own connector (read
# only), repaints the status chip of every [data-ticket] element, and keeps
# the last good statuses on any failure. Error copy branches on the
# capability's error codes, as the mcp contract asks.
LIVE_SCRIPT = r"""
(function () {
  var btn = document.getElementById('plan-refresh');
  var note = document.getElementById('plan-refresh-note');
  var plan = JSON.parse(document.getElementById('plan-data').textContent);
  var CLOSED = { Done: 1, Canceled: 1, Duplicate: 1 };
  var since = plan.statuses_at || plan.generated_on;
  var mcp = null;
  function say(text, warn) { note.textContent = text; note.classList.toggle('warn', !!warn); }
  function stamp(d) { return d.toLocaleString(undefined, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); }
  // The statuses the plan was published with: every refresh is measured
  // against these, never against the previous refresh's repaint.
  var original = {};
  document.querySelectorAll('[data-ticket]').forEach(function (el) {
    var chip = el.querySelector('[data-status]');
    if (chip) original[el.getAttribute('data-ticket')] = chip.textContent;
  });
  function apply(statuses) {
    var moved = {};
    document.querySelectorAll('[data-ticket]').forEach(function (el) {
      var id = el.getAttribute('data-ticket');
      var s = statuses[id];
      var chip = el.querySelector('[data-status]');
      if (!s || !chip) return;
      chip.textContent = s;
      var differs = s !== original[id];
      el.classList.toggle('changed', differs);
      el.classList.toggle('closed', !!CLOSED[s]);
      if (differs) moved[id] = 1;
    });
    return Object.keys(moved).length;
  }
  function explain(err) {
    var code = err && err.code;
    if (code === 'needs_reauth') return 'Reconnect Linear in claude.ai Settings, Connectors, then refresh.';
    if (code === 'server_not_connected' || code === 'selection_required') return 'Add Linear in claude.ai Settings, Connectors to refresh statuses.';
    if (code === 'not_in_manifest' || code === 'approval_required' || code === 'not_granted' || code === 'blocked_by_policy' || code === 'consent_required') return 'This page is not allowed to read Linear for you. Allow it from the artifact’s Permissions menu.';
    if (code === 'server_unavailable' || code === 'rate_limited') return 'Linear did not answer. Try again in a minute.';
    if (code === 'tool_error') return 'Linear refused the request: ' + (err.message || 'no reason given') + '.';
    return 'Could not refresh (' + (code || 'unknown error') + '). The statuses shown are from the plan.';
  }
  function page(cursor) {
    var input = { team: 'SNOW', updatedAt: since, limit: 250, fields: ['id', 'status'] };
    if (cursor) input.cursor = cursor;
    return mcp.callTool('Linear', 'list_issues', input, { cache: false });
  }
  function readAll() {
    var statuses = {};
    function step(cursor, n, retried) {
      return page(cursor).then(function (r) {
        var p = r.payload || {};
        (p.issues || []).forEach(function (i) { if (i.id && i.status) statuses[i.id] = i.status; });
        if (p.hasNextPage && p.cursor && n < 8) return step(p.cursor, n + 1, false);
        return statuses;
      }, function (err) {
        if (err && err.retryable && !retried) {
          var wait = Math.min(err.retryAfterMs || 1500 + Math.random() * 1500, 60000);
          return new Promise(function (ok) { setTimeout(ok, wait); }).then(function () { return step(cursor, n, true); });
        }
        throw err;
      });
    }
    return step(null, 0, false);
  }
  btn.addEventListener('click', function () {
    if (!mcp) return;
    btn.disabled = true;
    say('Reading Linear…');
    readAll().then(function (statuses) {
      var changed = apply(statuses);
      say('Statuses from Linear, ' + stamp(new Date()) + '. ' + (changed ? changed + (changed === 1 ? ' ticket has' : ' tickets have') + ' moved since this plan was written.' : 'Nothing has moved since this plan was written.'));
    }, function (err) { say(explain(err), true); }).then(function () { btn.disabled = false; });
  });
  if (window.claude && window.claude.use) {
    window.claude.use('mcp').then(function (m) { mcp = m; if (m) btn.hidden = false; }, function () {});
  }
})();
"""


def render(plan: dict[str, Any], previous: dict[str, Any] | None) -> str:
    """Render the whole page as an Artifact HTML fragment."""
    delta = diff(plan, previous)
    window = plan["window"]
    weeks = "".join(render_week(i, w) for i, w in enumerate(plan["weeks"]))
    signals = (
        "<ul class='signals'>"
        + "".join(f"<li>{esc(s)}</li>" for s in plan["signals"])
        + "</ul>"
        if plan["signals"]
        else '<p class="quiet">No competitor movement changed the ranking this week.</p>'
    )
    # "<" as \u003c: nothing in a title can close the script element, and
    # json.loads reads it back unchanged.
    embedded = json.dumps(plan, ensure_ascii=False, indent=1).replace("<", "\\u003c")
    legend = "".join(f'<span class="k-{k}">{k}</span>' for k in KINDS)
    return f"""<title>Snowdesk 30-Day Plan</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap">
{STYLE}
<main class="page">
  <header class="masthead">
    <p class="eyebrow">Plan of {esc(fmt_day(plan["generated_on"]))} · covers {esc(fmt_day(window["start"]))} – {esc(fmt_day(window["end"]))}</p>
    <h1>The next 30 days</h1>
    <p class="lede">{esc(plan["summary"])}</p>
    <div class="live">
      <button type="button" class="refresh" id="plan-refresh" hidden>Refresh statuses from Linear</button>
      <span class="live-note" id="plan-refresh-note" aria-live="polite">Statuses as of {esc(fmt_stamp(plan.get("statuses_at") or plan["generated_on"]))}.</span>
    </div>
  </header>
  {render_capacity(plan)}
  <div class="legend" aria-label="Ticket kinds">{legend}</div>
  <div class="weeks">{weeks}</div>
  <div class="panels">
    <section class="panel"><h3>Since last week</h3>{render_changes(delta)}</section>
    <section class="panel"><h3>Waiting on Hugo</h3>{render_list(plan["decisions"], "question")}</section>
    <section class="panel"><h3>Competitor signals</h3>{signals}</section>
    <section class="panel"><h3>Raised this run</h3>{render_list(plan["new_tickets"], "idea")}</section>
    <section class="panel wide"><h3>Written to Linear this run</h3>{render_linear_changes(plan["linear_changes"])}</section>
    <section class="panel wide"><details><summary>Not planned this month ({len(plan["not_planned"])})</summary>{render_list(plan["not_planned"], "reason")}</details></section>
  </div>
  <footer>Rendered by bin/render-plan from the plan-month skill's JSON. Ranking weights winter-season readiness and competitive gaps; see .claude/skills/plan-month/SKILL.md.</footer>
</main>
<script type="application/json" id="plan-data">{embedded}</script>
<script>{LIVE_SCRIPT}</script>
"""


def main(argv: list[str] | None = None) -> int:
    """Parse arguments, validate the plan, and write the page."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("plan", type=pathlib.Path, help="the plan JSON")
    parser.add_argument(
        "--previous",
        type=pathlib.Path,
        help="last week's rendered page, for the 'Since last week' panel",
    )
    parser.add_argument("--output", type=pathlib.Path, help="write here, not stdout")
    args = parser.parse_args(argv)

    plan = json.loads(args.plan.read_text(encoding="utf-8"))
    problems = validate(plan)
    if problems:
        for problem in problems:
            print(f"render-plan: {problem}", file=sys.stderr)
        return 1
    page = render(plan, read_previous(args.previous))
    if args.output:
        args.output.write_text(page, encoding="utf-8")
        planned = sum(len(w["items"]) for w in plan["weeks"])
        print(f"render-plan: {planned} tickets, {len(page)} bytes", file=sys.stderr)
    else:
        print(page)
    return 0


if __name__ == "__main__":
    sys.exit(main())
