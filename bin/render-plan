#!/usr/bin/env python3
# bin/render-plan — render the weekly 30-day plan as one Artifact page.
#
# The `plan-month` skill decides WHAT goes in the plan: it reads Linear and
# docs/competitors.md, scores every open ticket, and writes its judgement as
# one JSON document (schema below). This script decides only HOW that plan
# looks, so the page has the same shape every Monday whoever — or whatever —
# produced the JSON. A routine that hand-wrote HTML each week would drift in
# layout and in what it bothers to show; a renderer cannot.
#
# It also carries the plan forward. The JSON is embedded in the page it
# renders (<script type="application/json" id="plan-data">), so next week's
# run passes last week's page as --previous and the "Since last week" panel
# is computed rather than remembered: added, moved between weeks, shipped,
# dropped. The Artifact is the only state the plan has — a Routine has no
# persistent disk — and this is how it survives from one run to the next.
#
# The output is a self-contained HTML fragment — no <!doctype>, <html>,
# <head> or <body> of its own — the convention bin/render-churn and
# bin/render-day-summary-matrix share, so it publishes as an Artifact.
#
# Reads only. Prints to stdout unless --output names a file.
#
#     uv run python bin/render-plan /tmp/plan.json --previous /tmp/prev.html \
#         --output /tmp/plan.html
#
# Input schema (every key required unless marked optional):
#
#   generated_on   "YYYY-MM-DD"
#   window         {"start": "YYYY-MM-DD", "end": "YYYY-MM-DD"}
#   summary        2–3 sentences: what this month is for
#   capacity       {"done_42d": int, "unplanned_share": float 0–1,
#                   "planned_per_30d": int, "reserve_pct": int,
#                   "note": str}
#   weeks          four of {"label": str, "start": "YYYY-MM-DD",
#                   "theme": str, "items": [item, …]}
#   item           {"id": "SNOW-n", "title": str, "kind": one of KINDS,
#                   "area": str, "status": str, "estimate": int|null,
#                   "score": int, "why": str, "drivers": [one of DRIVERS]}
#   decisions      [{"id", "title", "question"}] — Requires input, for Hugo
#   new_tickets    [{"id", "title", "idea": str}] — raised this run
#   linear_changes [{"id", "field", "from", "to"}] — written this run
#   signals        [str] — competitor movements that moved the ranking
#   not_planned    [{"id", "title", "reason"}]
#   completed_since_last  optional [ids] — Done since the previous plan
#   statuses_at    optional ISO timestamp — when the embedded statuses were
#                  read from Linear (defaults to generated_on)
#
# The page is live as well as dated. Its Refresh button reads every SNOW
# ticket updated since `statuses_at` through the viewer's own Linear
# connector (the Artifact `mcp` capability, tool `list_issues`, read only)
# and repaints each ticket's status where it appears. Nothing is written
# back, and the plan itself (weeks, order, priorities) changes only when
# the next run republishes it. The publish must declare
#   capabilities: {mcp: {servers: [{server: "Linear", tools: ["list_issues"]}]}}
# once; later republishes omit `capabilities` and keep it.
#
# ruff: noqa: T201, E501
# T201 — CLI script; print() is the intended output channel.
# E501 — most of this file is an embedded HTML document and its CSS; the
#        same reasoning bin/render-churn's header gives.

"""30-day plan renderer — see the header block above for full behaviour."""

from __future__ import annotations

import argparse
import datetime as dt
import html
import json
import pathlib
import re
import sys
from typing import Any

KINDS = ("bug", "feature", "improvement", "chore")
DRIVERS = ("season", "competitive", "bug", "unblock")
DRIVER_LABELS = {
    "season": "Season",
    "competitive": "Rival ships it",
    "bug": "Broken today",
    "unblock": "Unblocks others",
}
LINEAR_URL = "https://linear.app/hugorodgerbrown/issue/{id}"
# Statuses a ticket leaves the plan's work through; drawn struck through.
CLOSED = ("Done", "Canceled", "Duplicate")
DATA_RE = re.compile(
    r'<script type="application/json" id="plan-data">(.*?)</script>', re.S
)


def esc(value: object) -> str:
    """HTML-escape any value for text or a double-quoted attribute."""
    return html.escape(str(value), quote=True)


def fmt_stamp(iso: str) -> str:
    """Render an ISO date or timestamp as '1 Nov' or '1 Nov, 15:50 UTC'."""
    if "T" not in iso:
        return fmt_day(iso)
    stamp = dt.datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(dt.UTC)
    return f"{stamp.day} {stamp:%b}, {stamp:%H:%M} UTC"


def fmt_day(iso: str) -> str:
    """Render an ISO date as '2 Nov'."""
    day = dt.date.fromisoformat(iso)
    return f"{day.day} {day:%b}"


REQUIRED_KEYS = (
    "generated_on",
    "window",
    "summary",
    "capacity",
    "weeks",
    "decisions",
    "new_tickets",
    "linear_changes",
    "signals",
    "not_planned",
)


def item_problems(item: dict[str, Any]) -> list[str]:
    """Return the schema problems in one planned ticket."""
    ident = item.get("id", "?")
    problems = []
    if item.get("kind") not in KINDS:
        problems.append(f"{ident}: kind {item.get('kind')!r} not in {KINDS}")
    problems.extend(
        f"{ident}: driver {driver!r} not in {DRIVERS}"
        for driver in item.get("drivers", [])
        if driver not in DRIVERS
    )
    return problems


def validate(plan: dict[str, Any]) -> list[str]:
    """Return every schema problem in ``plan``; empty when it is renderable."""
    problems = [f"missing key: {key}" for key in REQUIRED_KEYS if key not in plan]
    if problems:
        return problems
    if len(plan["weeks"]) != 4:
        problems.append(f"expected 4 weeks, got {len(plan['weeks'])}")
    seen: set[str] = set()
    for item in (i for week in plan["weeks"] for i in week.get("items", [])):
        if item.get("id") in seen:
            problems.append(f"{item['id']} is planned in two weeks")
        seen.add(item.get("id", "?"))
        problems.extend(item_problems(item))
    return problems


def read_previous(path: pathlib.Path | None) -> dict[str, Any] | None:
    """Extract the embedded plan JSON from last week's rendered page."""
    if path is None or not path.exists():
        return None
    match = DATA_RE.search(path.read_text(encoding="utf-8"))
    if not match:
        return None
    return json.loads(match.group(1))


def week_of(plan: dict[str, Any]) -> dict[str, tuple[int, str]]:
    """Map each planned ticket id to its week index (0–3) and week start date."""
    return {
        item["id"]: (index, week["start"])
        for index, week in enumerate(plan["weeks"])
        for item in week["items"]
    }


def diff(plan: dict[str, Any], previous: dict[str, Any] | None) -> dict[str, list]:
    """Compare this plan with the last one: added, moved, shipped, dropped.

    A move is judged on the week's start DATE, not its index: the window
    rolls forward a week every run, so a ticket that stays on 9 November
    goes from week 2 to week 1 without moving, and one left in week 2 has
    in fact slipped a week.
    """
    if previous is None:
        return {"added": [], "moved": [], "shipped": [], "dropped": [], "first": True}
    now, before = week_of(plan), week_of(previous)
    titles = {
        item["id"]: item["title"]
        for source in (previous, plan)
        for week in source["weeks"]
        for item in week["items"]
    }
    completed = set(plan.get("completed_since_last", []))
    gone = [ident for ident in before if ident not in now]
    return {
        "added": [(i, titles[i], now[i][0]) for i in now if i not in before],
        "moved": [
            (i, titles[i], before[i][1], now[i][1])
            for i in now
            if i in before and before[i][1] != now[i][1]
        ],
        "shipped": [(i, titles[i]) for i in gone if i in completed],
        "dropped": [(i, titles[i]) for i in gone if i not in completed],
        "first": False,
    }


def link(ident: str) -> str:
    """Render a ticket id as a link to Linear."""
    return f'<a class="id" href="{esc(LINEAR_URL.format(id=ident))}">{esc(ident)}</a>'


def closed_class(status: str | None) -> str:
    """Return the class that marks a ticket closed, or nothing when it is open."""
    return " closed" if status in CLOSED else ""


def render_item(item: dict[str, Any]) -> str:
    """One planned ticket as a row in its week lane."""
    drivers = "".join(
        f'<span class="driver d-{esc(d)}">{esc(DRIVER_LABELS[d])}</span>'
        for d in item.get("drivers", [])
    )
    estimate = item.get("estimate")
    size = {1: "XS", 2: "S", 3: "M", 5: "L"}.get(estimate, "–") if estimate else "–"
    return f"""
      <li class="item k-{esc(item["kind"])}{closed_class(item["status"])}" data-ticket="{esc(item["id"])}">
        <div class="item-head">
          <span class="kind">{esc(item["kind"])}</span>{link(item["id"])}
          <span class="size" title="Estimate">{esc(size)}</span>
        </div>
        <p class="item-title">{esc(item["title"])}</p>
        <p class="why">{esc(item["why"])}</p>
        <div class="meta"><span class="status" data-status>{esc(item["status"])}</span><span class="area">{esc(item["area"])}</span>{drivers}</div>
      </li>"""


def mix_bar(items: list[dict[str, Any]]) -> str:
    """Draw a thin stacked bar showing a week's mix of bugs, features and chores."""
    if not items:
        return '<div class="mix empty" aria-hidden="true"></div>'
    parts = []
    for kind in KINDS:
        count = sum(1 for item in items if item["kind"] == kind)
        if count:
            parts.append(
                f'<span class="seg k-{kind}" style="flex:{count}" title="{count} {kind}"></span>'
            )
    label = ", ".join(
        f"{sum(1 for i in items if i['kind'] == k)} {k}"
        for k in KINDS
        if any(i["kind"] == k for i in items)
    )
    return (
        f'<div class="mix" role="img" aria-label="{esc(label)}">{"".join(parts)}</div>'
    )


def render_week(index: int, week: dict[str, Any]) -> str:
    """One of the four week lanes."""
    items = week["items"]
    rows = "".join(render_item(item) for item in items) or (
        '<li class="none">Nothing planned — capacity held for whatever arrives.</li>'
    )
    return f"""
    <section class="week" aria-labelledby="w{index}">
      <header>
        <p class="eyebrow">{esc(week["label"])} · from {esc(fmt_day(week["start"]))}</p>
        <h2 id="w{index}">{esc(week["theme"])}</h2>
        {mix_bar(items)}
        <p class="count">{len(items)} ticket{"s" if len(items) != 1 else ""}</p>
      </header>
      <ol class="items">{rows}</ol>
    </section>"""


def render_changes(delta: dict[str, list]) -> str:
    """Render the 'Since last week' panel."""
    if delta["first"]:
        return '<p class="quiet">First plan in this series — next Monday shows what moved.</p>'
    rows = []
    for ident, title, week in delta["added"]:
        rows.append(
            f'<li><span class="chg add">New</span>{link(ident)} {esc(title)} <span class="quiet">→ week {week + 1}</span></li>'
        )
    for ident, title, was, now in delta["moved"]:
        arrow = "earlier" if now < was else "later"  # ISO dates sort as dates
        rows.append(
            f'<li><span class="chg move">Moved {arrow}</span>{link(ident)} {esc(title)} <span class="quiet">{esc(fmt_day(was))} → {esc(fmt_day(now))}</span></li>'
        )
    for ident, title in delta["shipped"]:
        rows.append(
            f'<li><span class="chg ship">Shipped</span>{link(ident)} {esc(title)}</li>'
        )
    for ident, title in delta["dropped"]:
        rows.append(
            f'<li><span class="chg drop">Dropped</span>{link(ident)} {esc(title)}</li>'
        )
    if not rows:
        return '<p class="quiet">Nothing moved since last week.</p>'
    tally = (
        f"+{len(delta['added'])} new · {len(delta['moved'])} moved · "
        f"{len(delta['shipped'])} shipped · {len(delta['dropped'])} dropped"
    )
    return f'<p class="tally">{tally}</p><ul class="changes">{"".join(rows)}</ul>'


def render_capacity(plan: dict[str, Any]) -> str:
    """Render the capacity strip: what the month can hold against what is planned."""
    cap = plan["capacity"]
    planned = sum(len(week["items"]) for week in plan["weeks"])
    budget = max(cap["planned_per_30d"], 1)
    usable = round(budget * (100 - cap["reserve_pct"]) / 100)
    fill = min(planned / budget, 1) * 100
    usable_pct = usable / budget * 100
    return f"""
  <section class="capacity" aria-label="Capacity">
    <div class="cap-figures">
      <div><span class="big">{planned}</span><span class="lbl">planned</span></div>
      <div><span class="big">{usable}</span><span class="lbl">usable capacity</span></div>
      <div><span class="big">{cap["done_42d"]}</span><span class="lbl">closed, last 6 weeks</span></div>
      <div><span class="big">{round(cap["unplanned_share"] * 100)}%</span><span class="lbl">of that unplanned</span></div>
    </div>
    <div class="cap-bar" role="img" aria-label="{planned} planned of {usable} usable, {cap["reserve_pct"]}% held in reserve">
      <span class="cap-fill" style="width:{fill:.1f}%"></span>
      <span class="cap-mark" style="left:{usable_pct:.1f}%"></span>
    </div>
    <p class="quiet">{esc(cap["note"])} The marker is usable capacity; the {cap["reserve_pct"]}% beyond it is held for bugs nobody has filed yet.</p>
  </section>"""


def render_list(rows: list[dict[str, Any]], tail: str) -> str:
    """Render a simple ticket list with one trailing field."""
    if not rows:
        return '<p class="quiet">None this week.</p>'
    return (
        "<ul class='plain'>"
        + "".join(
            f"<li class='row{closed_class(r.get('status'))}' data-ticket='{esc(r['id'])}'>"
            f"{link(r['id'])} <span class='status' data-status>{esc(r.get('status', ''))}</span> "
            f"<strong>{esc(r['title'])}</strong><br><span class='quiet'>{esc(r[tail])}</span></li>"
            for r in rows
        )
        + "</ul>"
    )


def render_linear_changes(rows: list[dict[str, Any]]) -> str:
    """Render the audit log of what this run wrote to Linear."""
    if not rows:
        return '<p class="quiet">No Linear fields changed this run.</p>'
    body = "".join(
        f"<tr><td>{link(r['id'])}</td><td>{esc(r['field'])}</td><td>{esc(r['from'])}</td><td>{esc(r['to'])}</td></tr>"
        for r in rows
    )
    return f"""<div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Field</th><th>Was</th><th>Now</th></tr></thead><tbody>{body}</tbody></table></div>"""


