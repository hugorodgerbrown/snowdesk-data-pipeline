#!/usr/bin/env python3
# bin/render-day-summary-matrix — render the day-summary copy grid as a page.
#
# The day summary beside the day-character label is chosen per bulletin
# from an 80-cell hand-authored matrix in
# apps/bulletins/services/day_summary.py. Eighty sentences spread across a
# module are hard to review as *copy*: the thing a reader needs is every
# sentence side by side, grouped by how the day moves, with some sense of
# which ones a season actually produces.
#
# This renders exactly that, and it computes every figure on the page from
# the matrix and the committed season mirrors rather than carrying them as
# prose. A cell edited in day_summary.py and not re-rendered here shows up
# as a stale page, not as a page that quietly disagrees with the site.
#
# The output is a self-contained HTML fragment — no <!doctype>, <html>,
# <head> or <body> of its own — the same convention as docs/page-audits/
# and docs/research/problem-card-redundancy/, so it publishes as an
# Artifact and still renders opened straight from disk.
#
# Reads only. Prints to stdout unless --output names a file.
#
#     uv run python bin/render-day-summary-matrix \
#         --output docs/research/day-summary-matrix/$(date +%F).html
#
# ruff: noqa: T201, E501
# T201 — CLI script; print() is the intended output channel.
# E501 — most of this file is an embedded HTML document. Rewrapping its
#        markup and CSS to 88 columns to satisfy a Python line-length rule
#        would damage the output for no reader's benefit, which is the same
#        reasoning behind pyproject's `extend-exclude = ["docs/research"]`.
#        The Python itself stays inside the limit.

"""Day-summary matrix renderer — see the header block above for full behaviour."""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import html
import json
import logging
import os
import pathlib
import sys
from typing import Any

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "config.settings.development")

import django  # noqa: E402 — must follow the settings-module assignment above

django.setup()

logging.disable(logging.WARNING)

from apps.bulletins.services import day_summary  # noqa: E402 — needs django.setup()
from apps.bulletins.services.render_model import (  # noqa: E402 — same
    RenderModelBuildError,
    build_render_model,
    compute_period_transition,
    problem_types_for,
)

MIRRORS = pathlib.Path("apps/bulletins/local_mirrors")

MOVEMENTS: tuple[str, ...] = ("static", "rising", "shifting", "easing")
LEVELS: tuple[int, ...] = (1, 2, 3, 4, 5)
READABILITIES: tuple[str, ...] = ("quiet", "readable", "hidden", "mixed")

LEVEL_NAMES: dict[int, str] = {
    1: "Low",
    2: "Moderate",
    3: "Considerable",
    4: "High",
    5: "Very high",
}
MOVEMENT_GLOSS: dict[str, str] = {
    "static": "The level holds all day, and nothing under it moves.",
    "rising": "The level climbs into the afternoon.",
    "shifting": "The level holds; a different problem takes the later window.",
    "easing": "The level falls — and the problem swaps rather than clears.",
}
# Illustrative inputs for a cell the archive has never produced, so an
# unseen cell still renders its sentence rather than a placeholder.
SPECIMENS: dict[str, list[str]] = {
    "quiet": [],
    "readable": ["wind_slab"],
    "hidden": ["persistent_weak_layers"],
    "mixed": ["wind_slab", "persistent_weak_layers"],
}


def _classify(render_model: dict[str, Any]) -> tuple[str, int, str, int, list[str]]:
    """
    Return one bulletin's grid coordinates and the inputs behind them.

    Args:
        render_model: A render model dict from ``build_render_model``.

    Returns:
        ``(movement, level, readability, source_level, problem_types)``.

    """
    traits: list[dict[str, Any]] = render_model.get("traits") or []
    transition = compute_period_transition(render_model)
    earlier = set(problem_types_for(traits, {"all_day", "earlier"}))
    later = set(problem_types_for(traits, {"later"}))
    movement = day_summary.classify_movement(
        transition.direction if transition is not None and transition.has_split else "",
        earlier,
        later,
    )
    peak = int((render_model.get("danger") or {}).get("number") or 1)
    if movement == "static" or transition is None:
        level = source = peak
    else:
        level = int(transition.destination_number)
        source = int(transition.source_number or transition.destination_number)
    types = problem_types_for(traits, {"all_day", "earlier", "later"})
    return movement, level, day_summary.classify_readability(set(types)), source, types


def _window_signature(
    render_model: dict[str, Any], periods: set[str]
) -> set[tuple[Any, ...]]:
    """
    Return a per-problem signature for one window: type, aspects, elevation.

    Used to tell a flat split whose problems genuinely move from one whose
    two windows are identical.

    Args:
        render_model: A render model dict.
        periods: ``validTimePeriod`` values to include.

    Returns:
        A set of ``(problem_type, aspects, lower, upper)`` tuples.

    """
    signature: set[tuple[Any, ...]] = set()
    for trait in render_model.get("traits") or []:
        if trait.get("time_period") not in periods:
            continue
        for problem in trait.get("problems") or []:
            elevation = problem.get("elevation") or {}
            signature.add(
                (
                    problem.get("problem_type"),
                    tuple(sorted(problem.get("aspects") or [])),
                    elevation.get("lower"),
                    elevation.get("upper"),
                )
            )
    return signature


def _flat_split_kind(
    render_model: dict[str, Any], earlier: set[str], later: set[str]
) -> str:
    """
    Say what actually differs across a split whose danger level does not move.

    Args:
        render_model: A render model dict.
        earlier: Problem types named for the earlier window.
        later: Problem types named for the later window.

    Returns:
        ``"new problem type"``, ``"same types, new ground"``, or
        ``"identical windows"``.

    """
    if later - earlier:
        return "new problem type"
    early = _window_signature(render_model, {"all_day", "earlier"})
    if early != _window_signature(render_model, {"later"}):
        return "same types, new ground"
    return "identical windows"


def census() -> dict[str, Any]:
    """
    Walk the committed season mirrors and count what the matrix has to cover.

    Returns:
        A dict of per-cell counts, representative inputs, movement totals,
        and the three narrative figures the page reports.

    """
    counts: collections.Counter[tuple[str, int, str]] = collections.Counter()
    specimens: dict[tuple[str, int, str], collections.Counter[Any]] = (
        collections.defaultdict(collections.Counter)
    )
    movements: collections.Counter[str] = collections.Counter()
    flat_splits: collections.Counter[str] = collections.Counter()
    splits = wet_arrivals = total = 0

    for path in sorted(MIRRORS.glob("*.ndjson")):
        for line in path.open():
            if not line.strip():
                continue
            record = json.loads(line)
            properties = (
                record.get("properties") if record.get("type") == "Feature" else record
            )
            try:
                render_model = build_render_model(properties or record)
            except RenderModelBuildError:
                continue
            total += 1

            movement, level, readability, source, types = _classify(render_model)
            counts[(movement, level, readability)] += 1
            specimens[(movement, level, readability)][(tuple(types), source)] += 1
            movements[movement] += 1

            transition = compute_period_transition(render_model)
            if transition is None or not transition.has_split:
                continue
            splits += 1
            traits = render_model.get("traits") or []
            earlier = set(problem_types_for(traits, {"all_day", "earlier"}))
            later = set(problem_types_for(traits, {"later"}))
            if "wet_snow" in (later - earlier):
                wet_arrivals += 1
            if transition.direction == "none":
                flat_splits[_flat_split_kind(render_model, earlier, later)] += 1

    return {
        "counts": counts,
        "specimens": specimens,
        "movements": movements,
        "flat_splits": flat_splits,
        "splits": splits,
        "wet_arrivals": wet_arrivals,
        "total": total,
    }


def _rows(data: dict[str, Any]) -> list[dict[str, Any]]:
    """
    Build one row per matrix cell, with its copy and its archive frequency.

    Args:
        data: The dict returned by :func:`census`.

    Returns:
        A list of row dicts in movement / level / readability order.

    """
    rows: list[dict[str, Any]] = []
    for movement in MOVEMENTS:
        for level in LEVELS:
            for readability in READABILITIES:
                key = (movement, level, readability)
                seen = data["specimens"][key]
                if seen:
                    (types, source), _ = seen.most_common(1)[0]
                    problems, from_archive = list(types), True
                else:
                    problems, from_archive, source = (
                        SPECIMENS[readability],
                        False,
                        level,
                    )
                row: dict[str, Any] = {
                    "movement": movement,
                    "level": level,
                    "readability": readability,
                    "count": data["counts"][key],
                    "problems": problems,
                    "from_archive": from_archive,
                    "text": day_summary.summary_for(
                        movement, level, problems, from_level=source
                    ),
                }
                if movement in {"rising", "easing"}:
                    # Both openings: the digit moving, and the subdivision-only
                    # move where it does not.
                    crossing = (
                        max(1, level - 1) if movement == "rising" else min(5, level + 1)
                    )
                    row["text"] = day_summary.summary_for(
                        movement, level, problems, from_level=crossing
                    )
                    row["same_band"] = day_summary.summary_for(
                        movement, level, problems, from_level=level
                    )
                rows.append(row)
    return rows


