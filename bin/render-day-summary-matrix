def _cell(row: dict[str, Any]) -> str:
    """
    Render one matrix cell.

    Args:
        row: A row dict from :func:`_rows`.

    Returns:
        An HTML ``<article>`` fragment.

    """
    seen = row["count"] > 0
    problems = (
        ", ".join(
            str(day_summary.PROBLEM_PHRASES[p])
            for p in row["problems"]
            if p in day_summary.PROBLEM_PHRASES
        )
        or "—"
    )
    frequency = (
        f'<span class="n">{row["count"]:,}</span>'
        if seen
        else '<span class="n zero">not seen</span>'
    )
    alternate = ""
    if row.get("same_band"):
        alternate = (
            '<p class="copy alt"><span class="altmark">same band</span>'
            f"{html.escape(row['same_band'])}</p>"
        )
    return f"""<article class="cell{"" if seen else " unseen"}">
 <div class="meta">
  <span class="lvl l{row["level"]}"><i></i>{row["level"]} {LEVEL_NAMES[row["level"]]}</span>
  <span class="rd">{row["readability"].title()}</span>
  {frequency}
 </div>
 <p class="copy">{html.escape(row["text"])}</p>
 {alternate}
 <p class="src">{html.escape(problems)}{"" if row["from_archive"] else " · illustrative"}</p>
</article>"""


def _section(movement: str, rows: list[dict[str, Any]], data: dict[str, Any]) -> str:
    """
    Render one movement's heading, statistics and cell grid.

    Args:
        movement: The movement key.
        rows: Every row for that movement.
        data: The dict returned by :func:`census`.

    Returns:
        An HTML ``<section>`` fragment.

    """
    total = data["movements"][movement]
    share = 100 * total / data["total"] if data["total"] else 0
    in_use = sum(1 for r in rows if r["count"])
    cells = "".join(_cell(r) for r in rows)
    return f"""<section class="movement" id="{movement}">
 <header class="mv-head">
  <div>
   <h2>{movement.title()}</h2>
   <p class="gloss">{html.escape(MOVEMENT_GLOSS[movement])}</p>
  </div>
  <dl class="mv-stats">
   <div><dt>Bulletins</dt><dd>{total:,}</dd></div>
   <div><dt>Share</dt><dd>{share:.1f}%</dd></div>
   <div><dt>Cells in use</dt><dd>{in_use}<span class="of">/20</span></dd></div>
  </dl>
 </header>
 <div class="grid">{cells}</div>
</section>"""


def render(data: dict[str, Any], stamp: dt.date) -> str:
    """
    Render the whole page.

    Every figure is computed from *data* rather than carried as prose, so a
    re-render after a copy edit cannot leave a stale number behind.

    Args:
        data: The dict returned by :func:`census`.
        stamp: The date the census was taken.

    Returns:
        The complete self-contained HTML fragment.

    """
    rows = _rows(data)
    seen = sum(1 for r in rows if r["count"])
    static_share = 100 * data["movements"]["static"] / data["total"]
    flat = data["flat_splits"]
    unchanged = flat["same types, new ground"] + flat["identical windows"]
    sections = "".join(
        _section(m, [r for r in rows if r["movement"] == m], data) for m in MOVEMENTS
    )
    return f"""{HEAD}

<div class="wrap">
 <header class="masthead">
  <p class="eyebrow">Snowdesk · bulletin copy review · {stamp:%-d %B %Y}</p>
  <h1>The day summary, one sentence at a time</h1>
  <p class="standfirst">{len(rows)} hand-authored sentences replacing five fixed ones. Each is
   chosen by how the day&rsquo;s danger moves, the level it reaches, and whether its problems
   leave anything on the surface to read. Counts are the {data["total"]:,} committed season
   mirrors.</p>
 </header>

 <dl class="summary">
  <div><dt>Cells authored</dt><dd>{len(rows)}</dd></div>
  <div><dt>Seen in archive</dt><dd>{seen}<small> / {len(rows)}</small></dd></div>
  <div><dt>Days that never change</dt><dd>{static_share:.1f}<small>%</small></dd></div>
  <div><dt>Split days improving</dt><dd>0</dd></div>
 </dl>

 <div class="findings">
  <div class="finding">
   <h3>A split day is the sun getting to work</h3>
   <p>Wet snow is the arriving problem on {data["wet_arrivals"]} of the {data["splits"]} days
      that split. Nothing else comes close.</p>
  </div>
  <div class="finding">
   <h3>Nothing ever improves</h3>
   <p>All {data["movements"]["easing"]} falling days replace a dry problem with wet snow. The
      number drops while the hazard swaps, so no sentence offers the afternoon as the safer
      half.</p>
  </div>
  <div class="finding">
   <h3>{unchanged} flat splits are not splits</h3>
   <p>Of the {sum(flat.values())} days whose level holds across a split,
      {flat["same types, new ground"]} keep the same problems on new ground and
      {flat["identical windows"]} carry two identical windows. Those read as static rather
      than promising a change.</p>
  </div>
 </div>

 {sections}

 <div class="rules">
  <h2>Rules for editing a cell</h2>
  <ul>
   <li><strong>One sentence, ending in a full stop.</strong> Tests assert both.</li>
   <li><strong>Never govern a verb from <code>%(problems)s</code>.</strong> It holds one name or
       four, so &ldquo;wind slab <em>is</em> named&rdquo; breaks on the second. Use a noun
       phrase: &ldquo;with %(problems)s at the surface&rdquo;.</li>
   <li><strong>A cell may use <code>%(problems)s</code> and <code>%(transition)s</code>, nothing
       else.</strong> The level words belong to the transition clause.</li>
   <li><strong>Quiet cells must not name problems; every other cell must.</strong> Both
       directions are tested.</li>
   <li><strong>No two cells share a sentence</strong> — a duplicate means one combination was
       written twice and another missed.</li>
   <li><strong>Don&rsquo;t claim an arrival.</strong> &ldquo;with wind slab arriving&rdquo; is
       false when wind slab ran all morning. Say what is in play; let the movement carry the
       direction.</li>
  </ul>
 </div>

 <footer>
  Sentences from <code>apps/bulletins/services/day_summary.py</code>; contract in
  <code>docs/day-summary.md</code>. Counts replay <code>build_render_model</code> and
  <code>compute_period_transition</code> over <code>apps/bulletins/local_mirrors/*.ndjson</code>.
  Regenerate with <code>bin/render-day-summary-matrix</code> after any copy edit. Cells marked
  <em>not seen</em> are authored but have never fired; their example problems are illustrative.
  Rising and easing cells render two openings — the second fires when the day moves on
  subdivision alone and the digit does not change. Level colours follow the EAWS danger scale.
 </footer>
</div>
"""


def main() -> int:
    """
    Parse arguments, run the census, and emit the page.

    Returns:
        Process exit code.

    """
    parser = argparse.ArgumentParser(description="Render the day-summary copy grid.")
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        help="write the page here instead of stdout",
    )
    parser.add_argument(
        "--date",
        type=dt.date.fromisoformat,
        default=dt.date.today(),
        help="census date stamped on the page (default: today)",
    )
    args = parser.parse_args()

    if not MIRRORS.exists():
        print(f"{MIRRORS} not found — run from the repo root.", file=sys.stderr)
        return 1

    # Strip trailing whitespace per line: a suppressed optional block leaves
    # an indent-only line, which the pre-commit hook would rewrite on every
    # commit — the file would churn against its own generator forever.
    page = "\n".join(line.rstrip() for line in render(census(), args.date).split("\n"))
    if args.output is None:
        print(page)
    else:
        args.output.write_text(page)
        print(f"Wrote {args.output} ({len(page):,} bytes)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
