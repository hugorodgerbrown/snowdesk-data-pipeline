#!/usr/bin/env python3
# bin/sw-version — Service-worker shell cache-version tool (SNOW-517).
#
# Single source of truth for static/js/sw.js's hand-bumped CACHE_VERSION
# constant. Wraps core/sw_shell.py (pure Python, no Django) — see that
# module's docstring for the content-hash / chicken-and-egg approach that
# decides whether a bump is owed.
#
# Modes:
#   bin/sw-version            # report committed version, sync status, next version
#   bin/sw-version --write    # bump CACHE_VERSION + regenerate the hash file
#                              # (idempotent — a no-op when already in sync)
#   bin/sw-version --check    # exit 0 in sync, 1 when a bump is owed (CI guard)
"""Service-worker shell cache-version CLI — see module docstring for full behaviour."""

# ruff: noqa: T201
# CLI script — print() is the intended output channel.

from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from core.sw_shell import (  # noqa: E402 — sys.path must be set up first
    bump_owed,
    compute_shell_hash,
    next_version,
    read_cache_version,
    write_cache_version,
    write_committed_hash,
)


def _report() -> int:
    """Print the committed version, sync status, and (if owed) the next version.

    Always exits 0 — this mode is informational, not a gate.
    """
    current = read_cache_version()
    owed = bump_owed()
    print(f"Committed version: {current}")
    print(f"Bump owed:         {'yes' if owed else 'no — shell is in sync'}")
    if owed:
        print(f"Next version:      {next_version(current)}")
    return 0


def _write() -> int:
    """Bump CACHE_VERSION and regenerate the hash file, if a bump is owed.

    Idempotent: a second run with nothing changed in between is a no-op.
    """
    if not bump_owed():
        print("Already in sync — no-op.")
        return 0
    current = read_cache_version()
    # Computed BEFORE the version-line rewrite below — the hash normalises
    # that line out, so the value is identical either side of the bump.
    new_hash = compute_shell_hash()
    new_version = next_version(current)
    write_cache_version(new_version)
    write_committed_hash(new_hash)
    print(f"Bumped {current} -> {new_version}; wrote static/js/sw-shell.hash.")
    return 0


def _check() -> int:
    """Exit 0 when in sync, 1 when the shell changed without a bump."""
    if not bump_owed():
        print(f"In sync at {read_cache_version()}.")
        return 0
    print(
        "Shell sources changed without a CACHE_VERSION bump — run "
        f"`bin/sw-version --write` (would bump to "
        f"{next_version(read_cache_version())})."
    )
    return 1


def main() -> int:
    """CLI entry point — see module docstring for behaviour and exit codes."""
    parser = argparse.ArgumentParser(
        description="Snowdesk service-worker shell cache-version tool.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--write",
        action="store_true",
        help="Bump CACHE_VERSION and regenerate sw-shell.hash if a bump is owed.",
    )
    mode.add_argument(
        "--check",
        action="store_true",
        help="Exit 0 when in sync, 1 when a bump is owed (CI guard).",
    )
    args = parser.parse_args()

    if args.write:
        return _write()
    if args.check:
        return _check()
    return _report()


if __name__ == "__main__":
    sys.exit(main())
