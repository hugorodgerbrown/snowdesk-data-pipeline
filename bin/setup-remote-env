#!/usr/bin/env bash
#
# bin/setup-remote-env — bootstrap Python 3.14 and the uv virtualenv in
# Claude Code remote (cloud) sessions.
#
# Remote containers ship with Python ≤ 3.13 but the project requires Python
# 3.14 (pyproject.toml: requires-python = ">=3.14,<4"). This script:
#
#   1. Exits immediately (no-op) when CLAUDE_CODE_REMOTE is not "true", so
#      local developer environments are never touched.
#   2. Resolves a *final* Python 3.14, upgrading uv from PyPI first when the
#      container's uv is too old to offer one.
#   3. Rebuilds the in-project virtualenv (.venv/) whenever it is missing or
#      unusable — uv's default location, which lets bin/init-worktree symlink
#      it into git worktrees.
#   4. Seeds a throwaway .env when the session has none, because settings read
#      SECRET_KEY through python-decouple with no default. tox does not
#      declare `passenv` for it, so an exported variable never reaches pytest
#      — only the file works. A cloud session starts from a fresh clone and
#      bin/init-worktree cannot help: it symlinks .env from the main repo and
#      refuses to run in the main worktree, which is precisely what a cloud
#      session checks out.
#   5. Verifies the result with `manage.py check` and shouts if it failed.
#
# Why "final" and not merely ">= 3.14"
# ------------------------------------
# The previous version accepted any interpreter named python3.14 and skipped
# the sync whenever a .venv directory existed. A container carrying CPython
# 3.14.0rc2 satisfied both tests, and the session was then unusable: pydantic
# calls typing._eval_type(..., prefer_fwd_module=True), a keyword that only
# landed in 3.14 final, so importing django-csp-plus's models raised
# TypeError and django.setup() never completed. No manage.py command, no
# pytest, no tox — while this script reported success and exited 0.
#
# The two lessons are encoded below: a release candidate is not the release
# (releaselevel must be "final"), and the presence of a .venv directory is not
# evidence that it works (import Django, don't stat a path).
#
# The uv upgrade goes through PyPI deliberately. Cloud environments running
# the "Trusted" network policy can reach pypi.org but not astral.sh, so
# `uv self update` and the standalone installer both fail there; the PyPI
# wheel bundles the same binary and is reachable.
#
# Idempotent: every step checks whether it is already done before acting, so
# re-running the script in a warm container costs about a second.
#
# Wired to the SessionStart hook in .claude/settings.json so it runs
# automatically before bin/init-worktree at the start of every remote session.
# That hook swallows the exit code (`|| true`) so a failure here can never
# block a session — which is why the failure path below is loud rather than
# merely non-zero.

set -euo pipefail

LOG_PREFIX="setup-remote-env"
PYTHON_VERSION="3.14"

# ── Guard: only run in Claude Code remote (cloud) sessions ─────────────────
if [ "${CLAUDE_CODE_REMOTE:-}" != "true" ]; then
    exit 0
fi

# Print an unmissable banner and exit non-zero. The SessionStart hook drops
# the exit code, so this text is the only signal the developer ever sees.
fail() {
    echo "" >&2
    echo "  ######################################################################" >&2
    echo "  $LOG_PREFIX: FAILED — the Python environment is NOT usable" >&2
    echo "" >&2
    while IFS= read -r line; do
        echo "  $line" >&2
    done <<< "$1"
    echo "" >&2
    echo "  manage.py, pytest and tox will all fail until this is resolved." >&2
    echo "  ######################################################################" >&2
    echo "" >&2
    exit 1
}

# True when $1 is a final (non-prerelease) CPython >= $PYTHON_VERSION.
# An rc/alpha/beta reports releaselevel "candidate"/"alpha"/"beta" and is
# rejected — see the header for what an rc costs us.
is_final_python() {
    local bin=${1:-}
    [ -n "$bin" ] && [ -x "$bin" ] || return 1
    # PYTHON_VERSION crosses into Python through the environment: the heredoc
    # is quoted so the shell cannot interpolate it, and hardcoding the floor
    # twice is how the two silently drift apart.
    SETUP_PYTHON_FLOOR="$PYTHON_VERSION" "$bin" - <<'PY' >/dev/null 2>&1
import os
import sys

major, minor = (int(part) for part in os.environ["SETUP_PYTHON_FLOOR"].split("."))
version = sys.version_info
ok = version[:2] >= (major, minor) and version.releaselevel == "final"
raise SystemExit(0 if ok else 1)
PY
}

# Human-readable version string, e.g. "3.14.0rc2" — used in log lines.
python_version_of() {
    "$1" -c 'import sys; print(sys.version.split()[0])' 2>/dev/null || echo "unknown"
}

# Upgrade uv from PyPI. Containers pin whatever uv was current when the image
# was built, and uv's list of downloadable interpreters is baked into the
# binary — an older uv simply does not know that 3.14 final exists.
upgrade_uv() {
    local output
    echo "$LOG_PREFIX: upgrading uv from PyPI (current: $(uv --version 2>/dev/null || echo none))"
    # Capture rather than pipe: piping through a filter would make grep's exit
    # status the verdict on pip, and grep reports failure when it filters
    # everything out — which is exactly what a clean pip run produces.
    if ! output=$(python3 -m pip install --user --quiet --upgrade uv 2>&1); then
        # A non-zero pip is not fatal on its own; the caller re-checks whether
        # a usable interpreter appeared and fails with full context if not.
        echo "$LOG_PREFIX: WARNING — pip could not upgrade uv" >&2
        echo "$output" | tail -5 >&2
    fi
    hash -r 2>/dev/null || true
    echo "$LOG_PREFIX: uv is now $(uv --version 2>/dev/null || echo unavailable)"
}

if ! command -v uv &>/dev/null; then
    fail "uv is not installed, so neither Python ${PYTHON_VERSION} nor the
virtualenv can be provisioned."
fi

# ── 1. Resolve a final Python 3.14 ─────────────────────────────────────────
# --system ignores any virtualenv in the working directory. Without it uv
# answers with .venv/bin/python, so a venv built on an rc would be offered as
# the interpreter to rebuild itself with and the repair below could never
# converge. An older uv that lacks the flag simply yields nothing here, which
# routes into the same install branch.
find_system_python() {
    uv python find "$PYTHON_VERSION" --system 2>/dev/null || true
}

python_bin=$(find_system_python)

if is_final_python "$python_bin"; then
    echo "$LOG_PREFIX: Python $(python_version_of "$python_bin") already present at $python_bin"
else
    if [ -n "$python_bin" ]; then
        echo "$LOG_PREFIX: $python_bin is $(python_version_of "$python_bin") — not a final release, replacing it"
    else
        echo "$LOG_PREFIX: no Python ${PYTHON_VERSION} found"
    fi

    # The container's uv may predate 3.14 final; upgrade before asking for it.
    upgrade_uv

    echo "$LOG_PREFIX: installing Python ${PYTHON_VERSION} via uv"
    # --force replaces the bin/ shim left by an earlier (possibly rc) install,
    # which uv otherwise refuses to overwrite because it did not create it.
    # A failure here must not abort under `set -e`: the diagnosis below is far
    # more useful than uv's one-liner, and the hook's `|| true` would reduce
    # an aborted run to a single line nobody reads.
    install_log=""
    if ! install_log=$(uv python install "$PYTHON_VERSION" --force 2>&1); then
        echo "$LOG_PREFIX: WARNING — uv could not install Python ${PYTHON_VERSION}" >&2
    fi
    # Spelt as an `if` rather than `[ -n … ] && echo`: under `set -e` that
    # AND-list would abort the script whenever the log came back empty.
    if [ -n "$install_log" ]; then
        echo "$install_log"
    fi
    python_bin=$(find_system_python)

    if ! is_final_python "$python_bin"; then
        fail "Could not obtain a final CPython ${PYTHON_VERSION}.
Best available: ${python_bin:-none} ($(python_version_of "${python_bin:-/nonexistent}"))

uv said:
$(echo "$install_log" | tail -5)

uv downloads interpreters from GitHub release assets and upgrades itself
from PyPI. If this environment's network policy blocks either, allowlist
them or pre-install Python ${PYTHON_VERSION} in the environment image."
    fi
    echo "$LOG_PREFIX: Python $(python_version_of "$python_bin") ready at $python_bin"
fi

# ── 2. Create or repair the in-project virtualenv ──────────────────────────
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# A .venv directory is not proof of a working environment. Require that its
# interpreter is a final 3.14 and that Django actually imports; anything less
# earns a rebuild. Deliberately avoids django.setup(), which needs SECRET_KEY
# from a .env that a fresh cloud session does not have.
venv_is_healthy() {
    [ -x ".venv/bin/python" ] || return 1
    is_final_python ".venv/bin/python" || return 1
    .venv/bin/python -c "import django" >/dev/null 2>&1 || return 1
}

if venv_is_healthy; then
    echo "$LOG_PREFIX: .venv healthy (Python $(python_version_of .venv/bin/python)), skipping uv sync"
else
    if [ -e ".venv" ]; then
        echo "$LOG_PREFIX: .venv is unusable — rebuilding it"
        # Removes a worktree symlink rather than the main repo's venv behind
        # it; uv sync then builds a real one in place.
        rm -rf .venv
    fi
    echo "$LOG_PREFIX: creating virtualenv with Python $(python_version_of "$python_bin")"
    uv sync --python "$python_bin"
fi

# ── 3. Seed a throwaway .env when the session has none ─────────────────────
# Never overwrites an existing file: a developer's real .env carries live
# credentials and is not ours to replace.
if [ -f ".env" ]; then
    echo "$LOG_PREFIX: .env already present, leaving it alone"
elif [ -f ".env.example" ]; then
    .venv/bin/python - <<'PY'
"""Copy .env.example to .env, minting a random SECRET_KEY as we go.

The container is ephemeral and .env is gitignored, so this key exists only
for the lifetime of one cloud session and never reaches a real environment.
"""

import pathlib
import secrets

lines = []
for line in pathlib.Path(".env.example").read_text().splitlines(keepends=True):
    if line.startswith("SECRET_KEY="):
        line = f"SECRET_KEY={secrets.token_urlsafe(50)}\n"
    lines.append(line)
pathlib.Path(".env").write_text("".join(lines))
PY
    echo "$LOG_PREFIX: seeded .env from .env.example with a throwaway SECRET_KEY"
else
    echo "$LOG_PREFIX: WARNING — no .env and no .env.example; tests needing SECRET_KEY will fail" >&2
fi

# ── 4. Verify — never report success without proving it ────────────────────
# Prefer the .env the session will actually use, so a malformed one is caught
# here rather than by the first command the developer runs. Falls back to an
# injected key (python-decouple reads the environment before .env) only when
# there is no .env to read.
run_django_check() {
    if [ -f ".env" ]; then
        DJANGO_SETTINGS_MODULE="config.settings.development" \
            .venv/bin/python manage.py check 2>&1
    else
        SECRET_KEY="setup-remote-env-smoke-check" \
        DJANGO_SETTINGS_MODULE="config.settings.development" \
            .venv/bin/python manage.py check 2>&1
    fi
}

if ! check_output=$(run_django_check); then
    fail "The virtualenv was built but 'manage.py check' failed:

$(echo "$check_output" | tail -20)"
fi

echo "$LOG_PREFIX: verified with manage.py check — 'uv run tox' should now work"
