#!/usr/bin/env python3
# bin/migrations-lint — catch colliding Django migrations before they reach
# main (SNOW-652).
#
# main went red on 2026-08-08 because SNOW-571 (#609) and SNOW-582 (#613)
# each added a migration depending on ``0014_bulletin_source``. Two leaf
# nodes, and ``migrate`` refuses to run a multi-leaf graph at all — so every
# test in the suite errored at database setup, no PR could merge, and the
# production release was blocked until it was fixed.
#
# WHY ``django-checks`` DID NOT CATCH IT FIRST. It did — but only on main,
# after both had merged. ``makemigrations --check`` inspects the tree it is
# given, and the repository ruleset deliberately does not require a PR to be
# up to date with main (``strict_required_status_checks_policy: false``), so
# each PR's own run saw a tree containing its migration and NOT the other's.
# Both were honestly green. The collision existed only in the union.
#
# WHY THIS CHECK SEES IT. On a ``pull_request`` event, GitHub checks out the
# MERGE commit of head into base, so the working tree here already holds
# main's migrations alongside the PR's. That union is exactly what was
# missing, and it needs no fetch, no base ref, and no network — the same
# property that makes a conflicting PR run no workflows at all (there is no
# merge commit to build).
#
# Two invariants, both derived from filenames and ``dependencies`` lists
# only — no Django import, no settings, no database:
#
#   1. NO DUPLICATE NUMBERS within an app. Two files sharing a ``NNNN_``
#      prefix are the fingerprint of two branches numbering off the same
#      parent. Occasionally the graph is still valid (one depends on the
#      other), which is why this is reported separately from invariant 2 —
#      it is confusing rather than broken, and worth fixing anyway.
#
#   2. EXACTLY ONE LEAF per app. A leaf is a migration nothing else in its
#      app depends on. Two leaves is the state that stops ``migrate`` dead.
#      This is the one that actually broke main.
#
# Exit code: 0 = clean; 1 = one or more violations.
#
# Usage:
#   bin/migrations-lint            # check every app
#   bin/migrations-lint --show-leaves   # print each app's leaf migration
"""Django migration collision guard — see module docstring for behaviour."""

# ruff: noqa: T201
# CLI script — print() is the intended output channel.

from __future__ import annotations

import argparse
import ast
import re
import sys
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
APPS_ROOT = REPO_ROOT / "apps"

NUMBER_RE = re.compile(r"^(\d{4})_")


@dataclass(frozen=True)
class Violation:
    """One migration-graph problem in one app."""

    app: str
    message: str


def _migration_files(app_dir: Path) -> list[Path]:
    """Return an app's migration modules, excluding ``__init__``."""
    return sorted(
        p
        for p in (app_dir / "migrations").glob("*.py")
        if p.stem != "__init__" and NUMBER_RE.match(p.stem)
    )


def _dependencies(path: Path) -> list[tuple[str, str]]:
    """Return the ``(app_label, migration_name)`` pairs a migration declares.

    Parsed with ``ast`` rather than imported: this script must run in the
    dependency-free lint env, with no Django and no settings module. Only
    literal 2-tuples are recognised, which is the only shape Django's own
    autogenerated migrations produce. A computed dependency (rare, and
    always hand-written) is skipped rather than guessed at.
    """
    tree = ast.parse(path.read_text(encoding="utf-8"))
    for node in ast.walk(tree):
        if not isinstance(node, ast.Assign):
            continue
        if not any(
            isinstance(t, ast.Name) and t.id == "dependencies" for t in node.targets
        ):
            continue
        if not isinstance(node.value, ast.List | ast.Tuple):
            continue
        pairs = []
        for element in node.value.elts:
            if isinstance(element, ast.Tuple) and len(element.elts) == 2:
                first, second = element.elts
                if isinstance(first, ast.Constant) and isinstance(second, ast.Constant):
                    pairs.append((str(first.value), str(second.value)))
        return pairs
    return []


def _check_app(app_dir: Path) -> tuple[list[Violation], str | None]:
    """Check one app; return its violations and its sole leaf (if exactly one)."""
    app = app_dir.name
    files = _migration_files(app_dir)
    if not files:
        return [], None

    violations: list[Violation] = []

    by_number: dict[str, list[str]] = defaultdict(list)
    for path in files:
        match = NUMBER_RE.match(path.stem)
        if match:
            by_number[match.group(1)].append(path.stem)
    for number, names in sorted(by_number.items()):
        if len(names) > 1:
            violations.append(
                Violation(
                    app,
                    f"duplicate migration number {number}: {', '.join(sorted(names))} "
                    f"— two branches numbered off the same parent; renumber the "
                    f"later one and re-point its `dependencies`",
                )
            )

    names = {path.stem for path in files}
    depended_on: set[str] = set()
    for path in files:
        for dep_app, dep_name in _dependencies(path):
            if dep_app == app:
                depended_on.add(dep_name)
    leaves = sorted(names - depended_on)

    if len(leaves) > 1:
        violations.append(
            Violation(
                app,
                f"{len(leaves)} leaf migrations: {', '.join(leaves)} — `migrate` "
                f"refuses a multi-leaf graph outright, so this breaks every test "
                f"and every deploy. Chain the later one onto the other",
            )
        )

    return violations, leaves[0] if len(leaves) == 1 else None


def main() -> int:
    """Run the guard — see module docstring for behaviour and exit codes."""
    parser = argparse.ArgumentParser(description="Django migration collision guard.")
    parser.add_argument(
        "--show-leaves",
        action="store_true",
        help="Print each app's leaf migration and exit.",
    )
    args = parser.parse_args()

    app_dirs = sorted(d for d in APPS_ROOT.iterdir() if (d / "migrations").is_dir())
    violations: list[Violation] = []
    leaves: list[tuple[str, str | None]] = []

    for app_dir in app_dirs:
        app_violations, leaf = _check_app(app_dir)
        violations.extend(app_violations)
        if _migration_files(app_dir):
            leaves.append((app_dir.name, leaf))

    if args.show_leaves:
        for app, leaf in leaves:
            print(f"{app}: {leaf or '(not a single leaf — see violations)'}")
        return 0

    for v in violations:
        print(f"apps/{v.app}/migrations: {v.message}")
    print(f"\nScanned {len(leaves)} app(s) with migrations | {len(violations)} violation(s)")
    return 1 if violations else 0


if __name__ == "__main__":
    sys.exit(main())
