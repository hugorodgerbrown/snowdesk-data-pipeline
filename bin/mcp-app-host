#!/usr/bin/env python3
"""
bin/mcp-app-host — a minimal local MCP Apps host for exercising ui:// views.

Serves one page (``bin/mcp-app-host.html``) that plays the host's half of
the MCP Apps extension (spec 2026-01-26) against a Snowdesk MCP endpoint:
it lists the tools, calls one, fetches the tool's ``_meta.ui.resourceUri`` with
``resources/read``, and renders the HTML in a sandboxed iframe under a CSP
built from the resource's ``_meta.ui.csp`` the way the spec tells a host
to. It then answers the view's ``ui/*`` requests and proxies its
``tools/call`` requests (refusing any tool whose visibility excludes
"app"), logging every message in both directions.

It exists because Claude cannot reach a localhost server as a connector.
It is a test fixture, not a reference host — see the ext-apps repo's
``examples/basic-host`` for that.

Usage::

    uv run python manage.py mint_mcp_token --email you@example.com --commit -v 0
    bin/mcp-app-host --port 8765
    # open http://localhost:8765/?mcp=http://localhost:8000/api/mcp/
    # and paste the token into the page's Token field

The endpoint requires a bearer token (SNOW-1035). The page sends it in an
``Authorization`` header and this script forwards that header upstream.

The page's POSTs go to this script's ``/mcp`` path, which forwards them to
the ``?mcp=`` URL — the browser cannot POST cross-origin to Django without
CORS headers Snowdesk does not send. Only localhost targets are forwarded.

``?worker=blob`` adds ``worker-src blob:`` to the view's CSP. The spec's
default policy has no worker-src, so MapLibre's blob: worker is refused and
the danger map falls back to SVG; the flag shows the MapLibre path.
"""

from __future__ import annotations

import argparse
import sys
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

_ALLOWED_HOSTS = {"localhost", "127.0.0.1", "[::1]"}

PAGE = Path(__file__).with_name("mcp-app-host.html")


class Handler(BaseHTTPRequestHandler):
    """Serve the host page and forward ``POST /mcp`` to a localhost MCP server."""

    def do_GET(self) -> None:
        """Serve the host page for any path."""
        body = PAGE.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        """Forward a JSON-RPC body to the ``target`` query parameter."""
        query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        target = (query.get("target") or [""])[0]
        parsed = urllib.parse.urlsplit(target)
        host = parsed.hostname or ""
        if parsed.scheme != "http" or (
            host not in _ALLOWED_HOSTS and f"[{host}]" not in _ALLOWED_HOSTS
        ):
            self.send_error(400, "target must be an http://localhost URL")
            return
        payload = self.rfile.read(int(self.headers.get("Content-Length", "0")))
        headers = {"Content-Type": "application/json"}
        if authorization := self.headers.get("Authorization"):
            headers["Authorization"] = authorization
        upstream = urllib.request.Request(  # noqa: S310 — http://localhost only, checked above
            target, data=payload, headers=headers
        )
        try:
            # semgrep dynamic-urllib-use: scheme and host are checked above.
            # nosemgrep
            with urllib.request.urlopen(upstream, timeout=30) as response:  # noqa: S310 — localhost-only, checked above
                status, body = response.status, response.read()
        except urllib.error.HTTPError as exc:
            status, body = exc.code, exc.read()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def main() -> None:
    """Parse ``--port`` and serve until interrupted."""
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--port", type=int, default=8765)
    args = parser.parse_args()
    sys.stdout.write(f"mcp-app-host on http://localhost:{args.port}/\n")
    ThreadingHTTPServer(("127.0.0.1", args.port), Handler).serve_forever()


if __name__ == "__main__":
    main()
