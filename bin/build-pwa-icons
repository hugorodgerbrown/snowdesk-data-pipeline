#!/usr/bin/env node
/*
 * bin/build-pwa-icons — Render PWA icon PNGs from static/favicon.svg.
 *
 * Outputs two sets of four files.
 *
 * Production set (static/icons/pwa/) — the canonical Snowdesk brand icons:
 *   - icon-192.png            (192×192, purpose: any)
 *   - icon-512.png            (512×512, purpose: any)
 *   - icon-maskable-512.png   (512×512, purpose: maskable)
 *   - apple-touch-icon-180.png (180×180, opaque background, no alpha —
 *                               iOS rounds the corners automatically and
 *                               can't render transparency in home-screen
 *                               icons cleanly)
 *
 * Staging set (static/icons/pwa-staging/, SNOW-399) — same four files but
 * on an amber tile with an asterisk set off the mountain's top right.
 * Both sit inside the maskable safe zone (80% of the canvas) so
 * Android's adaptive mask never crops them.
 *
 * Snowdesk deploys the same codebase to staging (*.onrender.com) and
 * production (snowdesk.info). Once a tester has both installed as PWAs,
 * the two home-screen tiles look identical — this ships a launcher tile
 * that reads as unambiguously non-production from three feet away, so
 * staging sessions can't be confused for production ones.
 *
 * SEASON LABEL
 * ------------
 * Every PWA icon carries the two-year season identifier ("25/26") in a
 * band at the foot of the tile, so an installed home-screen icon says
 * which season the app is serving without launching it. The mountain
 * glyph is lifted by MOUNTAIN_LIFT units of the 32-unit viewBox to clear
 * the band. static/favicon.svg itself is left untouched: the browser-tab
 * favicon renders at 16px, where five glyphs are illegible — the label
 * is a home-screen-tile affordance only.
 *
 * The label is derived from SEASON_START_DATE, which mirrors the Django
 * setting of the same name (config/settings/base.py). Because the PNGs
 * are checked in, they go stale the moment that setting rolls over to a
 * new season; ``static/icons/pwa-build.json`` records the label baked
 * into the committed PNGs and tests/public/test_pwa_icons.py asserts it
 * still matches the configured season, so the roll-over surfaces as a
 * failing test rather than a wrong icon nobody notices.
 *
 * Run via ``npm run build:icons`` (see package.json). The PNGs are
 * checked in alongside ``static/favicon.svg`` — when the SVG or the
 * season changes, regenerate and commit the new outputs.
 *
 * OPAQUE VARIANTS AND THE TILE COLOUR
 * -----------------------------------
 * Two of the four files are flattened onto an opaque backdrop rather
 * than keeping the SVG's transparent corners: the maskable PNG (which
 * pads the artwork inside a "safe zone", 80% of the canvas, so adaptive
 * icon shapes on Android don't crop the glyph) and the apple-touch icon
 * (iOS can't render transparency in home-screen icons cleanly).
 *
 * Both use the set's own TILE_COLOUR — the fill of the rounded rect in
 * the artwork itself — never the manifest background_color. Any other
 * choice shows as a visible border once the OS masks the icon: Android's
 * circular crop clips into the maskable padding at the cardinal edges,
 * and iOS's squircle leaves slivers at the corners of the apple-touch
 * icon. A backdrop that matches the tile makes those areas
 * indistinguishable from the icon's own rect. SNOW-151 established this for the
 * production maskable; the staging maskable (whose canvas, #7c2d12, was
 * a shade darker than its rect fill, #b45309) and the production
 * apple-touch icon (flattened onto the cream background_color) were
 * later fixed the same way.
 *
 * The flattened PNGs must be opaque (no alpha channel) — Android's
 * adaptive-icon mask leaks transparency at the masked corners if the
 * PNG retains an alpha channel, causing the logo to appear shrunken on
 * a white background. ``flatten`` composites transparent pixels onto
 * the supplied background colour; ``removeAlpha`` then drops the alpha
 * channel so the PNG encoder writes RGB (color_type 2) not RGBA
 * (color_type 6). Both steps are required under sharp >= 0.33 —
 * ``flatten`` alone no longer drops the channel.
 *
 * The purpose:any variants (192 and 512) keep their alpha: the browser
 * composites them itself and a transparent corner is correct there.
 *
 * Keep TILE_COLOUR_STAGING and the theme_color in
 * apps/public/site_environment.PWAEnvironmentIdentity.STAGING in the same
 * amber family — the two are seen side by side (status bar next to
 * icon) on installed Android PWAs.
 */

'use strict';

const fs = require('node:fs');
const path = require('node:path');
const sharp = require('sharp');

const REPO_ROOT = path.resolve(__dirname, '..');
const SRC_SVG = path.join(REPO_ROOT, 'static', 'favicon.svg');
const OUT_DIR_PROD = path.join(REPO_ROOT, 'static', 'icons', 'pwa');
const OUT_DIR_STAGING = path.join(REPO_ROOT, 'static', 'icons', 'pwa-staging');
const BUILD_MANIFEST = path.join(REPO_ROOT, 'static', 'icons', 'pwa-build.json');

// Brand green — must match the rect fill in static/favicon.svg. Doubles
// as the opaque backdrop for the production maskable and apple-touch
// PNGs, so a masked corner clips green-on-green (SNOW-151).
const TILE_COLOUR_PRODUCTION = '#2d4a3e';

// SNOW-399 — the staging tile colour, replacing the brand green in the
// recoloured artwork and backing the same two flattened PNGs.
// The matching theme colour lives in
// apps/public/site_environment.PWAEnvironmentIdentity.STAGING and drives the
// OS status-bar tint next to the installed icon.
const TILE_COLOUR_STAGING = '#b45309';

// Brand cream — must match the mountain fill in static/favicon.svg. The
// season band and the staging asterisk reuse it so every light mark on
// the tile is the same white.
const FOREGROUND_COLOUR = '#f2f0ec';

const SAFE_ZONE_RATIO = 0.8;

// Units of the 32-unit viewBox the mountain glyph is raised by to clear
// the season band at the foot of the tile.
const MOUNTAIN_LIFT = 4;

// Default season start — mirrors SEASON_START_DATE in
// config/settings/base.py. Override via the environment variable of the
// same name when building icons for a different season.
const SEASON_START_DEFAULT = '2025-11-01';

/**
 * Build the SLF-style two-year season identifier (e.g. "25/26") from an
 * ISO season-start date. Mirrors ``_season_label`` in
 * apps/public/season_calendar.py — the Northern-hemisphere avalanche
 * season runs from autumn through to late spring of the following year,
 * so the label is always two two-digit years separated by a slash.
 */
function seasonLabelFor(startIso) {
  const match = /^(\d{4})-\d{2}-\d{2}$/.exec(startIso);
  if (!match) {
    throw new Error(
      `SEASON_START_DATE must be an ISO date (YYYY-MM-DD), got: ${startIso}`,
    );
  }
  const year = Number(match[1]);
  const pad = (n) => String(n % 100).padStart(2, '0');
  return `${pad(year)}/${pad(year + 1)}`;
}

/**
 * Render the season band as an SVG <text> element.
 *
 * Font size 7 and baseline y=29 of the 32-unit viewBox put the label in
 * the 11 units the lifted mountain vacates, with roughly equal air above
 * the cap height and below the baseline. Both sit inside the maskable
 * safe zone (~y=3.2 to y=28.8 before the lift is applied, and the whole
 * 32-unit tile is scaled into that zone) so Android's adaptive mask
 * never crops the label.
 */
function seasonBand(label) {
  return (
    `<text x="16" y="29" font-family="Arial, Helvetica, sans-serif"` +
    ` font-size="7" font-weight="700" text-anchor="middle"` +
    ` fill="${FOREGROUND_COLOUR}" letter-spacing="0.1">${label}</text>`
  );
}

/**
 * Read the checked-in production favicon SVG, lift the mountain glyph to
 * clear the season band, and composite the band itself.
 *
 * For the staging set the rect fill is also recoloured and an asterisk
 * is set off the mountain's top right, the way a footnote marker hangs
 * off a word. It is drawn in the brand cream, the same fill as the
 * mountain and the season band — the tile has no other white, and a
 * pure #ffffff sitting inches from the cream glyph would read as a
 * mistake. Placed at (26.5, 13) of the 32-unit viewBox it clears both
 * the lifted mountain's right peak and the rounded corner, and survives
 * iOS's squircle crop on the apple-touch icon; on the maskable variant
 * the whole tile is scaled into the safe zone first, so Android's mask
 * never reaches it.
 *
 * The string replacements target the exact production shape (see the
 * check in main()); a future SVG rewrite that changes it surfaces as a
 * build-time mismatch, not a silent no-op.
 */
function loadSourceSvg(variant, label) {
  const svg = fs.readFileSync(SRC_SVG, 'utf8');
  const lifted = svg.replace(
    '<path ',
    `<path transform="translate(0 -${MOUNTAIN_LIFT})" `,
  );
  if (variant === 'production') {
    return Buffer.from(
      lifted.replace('</svg>', `${seasonBand(label)}</svg>`),
      'utf8',
    );
  }
  const recoloured = lifted.replace(
    `fill="${TILE_COLOUR_PRODUCTION}"`,
    `fill="${TILE_COLOUR_STAGING}"`,
  );
  const asterisk =
    '<text x="26.5" y="13" font-family="Arial, Helvetica, sans-serif"' +
    ' font-size="16" font-weight="700" text-anchor="middle"' +
    ` fill="${FOREGROUND_COLOUR}">*</text>`;
  return Buffer.from(
    recoloured.replace('</svg>', `${asterisk}${seasonBand(label)}</svg>`),
    'utf8',
  );
}

async function buildAny(size, outName, outDir, srcSvg) {
  const outPath = path.join(outDir, outName);
  await sharp(srcSvg).resize(size, size).png().toFile(outPath);
  console.log(`wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, any)`);
}

async function buildMaskable(size, outName, outDir, srcSvg, tileColour) {
  const outPath = path.join(outDir, outName);
  const inner = Math.round(size * SAFE_ZONE_RATIO);
  const pad = Math.round((size - inner) / 2);
  const innerBuffer = await sharp(srcSvg).resize(inner, inner).png().toBuffer();
  await sharp({
    create: {
      width: size,
      height: size,
      channels: 4,
      background: tileColour,
    },
  })
    .composite([{ input: innerBuffer, top: pad, left: pad }])
    // Flatten fills transparent areas with the tile colour, then
    // removeAlpha drops the alpha channel entirely so the PNG is written
    // as RGB (color_type 2) not RGBA (color_type 6). Both steps are needed:
    // flatten alone doesn't drop the channel in sharp >= 0.33; removeAlpha
    // alone would fill with black. Together they ensure Android's adaptive-
    // icon mask doesn't leak transparency at the masked corners.
    .flatten({ background: tileColour })
    .removeAlpha()
    .png()
    .toFile(outPath);
  console.log(
    `wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, maskable, ${SAFE_ZONE_RATIO * 100}% safe zone)`,
  );
}

async function buildAppleTouchIcon(size, outName, outDir, srcSvg, tileColour) {
  const outPath = path.join(outDir, outName);
  // iOS home-screen icons cannot be transparent — flatten the SVG over
  // the tile colour so the corners iOS's squircle mask leaves behind
  // clip tile-on-tile rather than showing a lighter fringe. ``flatten``
  // composites transparent pixels onto the background; ``removeAlpha``
  // then drops the alpha channel so the PNG is written as opaque RGB
  // (color_type 2). Both steps are required under sharp >= 0.33 (see
  // buildMaskable).
  await sharp(srcSvg)
    .resize(size, size)
    .flatten({ background: tileColour })
    .removeAlpha()
    .png()
    .toFile(outPath);
  console.log(
    `wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, apple-touch, opaque)`,
  );
}

async function buildSet({ variant, outDir, tileColour, label }) {
  fs.mkdirSync(outDir, { recursive: true });
  const srcSvg = loadSourceSvg(variant, label);
  await buildAny(192, 'icon-192.png', outDir, srcSvg);
  await buildAny(512, 'icon-512.png', outDir, srcSvg);
  await buildMaskable(512, 'icon-maskable-512.png', outDir, srcSvg, tileColour);
  await buildAppleTouchIcon(180, 'apple-touch-icon-180.png', outDir, srcSvg, tileColour);
}

async function main() {
  if (!fs.existsSync(SRC_SVG)) {
    console.error(`source SVG not found: ${SRC_SVG}`);
    process.exit(1);
  }
  // The staging recolour and the mountain lift depend on the exact
  // production SVG shape. Guard here so a future SVG rewrite surfaces as
  // a build error rather than a silent no-op that ships an amber-less
  // staging tile or a mountain overlapping the season band.
  const svg = fs.readFileSync(SRC_SVG, 'utf8');
  if (!svg.includes(`fill="${TILE_COLOUR_PRODUCTION}"`)) {
    console.error(
      `expected fill="${TILE_COLOUR_PRODUCTION}" in static/favicon.svg — update` +
        ' TILE_COLOUR_PRODUCTION if the brand colour has moved',
    );
    process.exit(1);
  }
  if (!svg.includes('<path ')) {
    console.error(
      'expected a single <path> (the mountain glyph) in static/favicon.svg —' +
        ' update the mountain lift in loadSourceSvg() if the artwork has changed',
    );
    process.exit(1);
  }

  const seasonStart = process.env.SEASON_START_DATE || SEASON_START_DEFAULT;
  const label = seasonLabelFor(seasonStart);
  console.log(`season label: ${label} (from SEASON_START_DATE=${seasonStart})`);

  await buildSet({
    variant: 'production',
    outDir: OUT_DIR_PROD,
    tileColour: TILE_COLOUR_PRODUCTION,
    label,
  });
  await buildSet({
    variant: 'staging',
    outDir: OUT_DIR_STAGING,
    tileColour: TILE_COLOUR_STAGING,
    label,
  });

  // Record what was baked into the committed PNGs so a test can fail when
  // the configured season moves on and the icons aren't regenerated.
  fs.writeFileSync(
    BUILD_MANIFEST,
    `${JSON.stringify({ season_label: label, season_start_date: seasonStart }, null, 2)}\n`,
    'utf8',
  );
  console.log(`wrote ${path.relative(REPO_ROOT, BUILD_MANIFEST)}`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
