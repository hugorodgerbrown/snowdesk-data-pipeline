#!/usr/bin/env node
/*
 * bin/build-pwa-icons — Render PWA icon PNGs from static/favicon.svg.
 *
 * Outputs two sets of four files.
 *
 * Production set (static/icons/pwa/) — the canonical Snowdesk brand icons:
 *   - icon-192.png            (192×192, purpose: any)
 *   - icon-512.png            (512×512, purpose: any)
 *   - icon-maskable-512.png   (512×512, purpose: maskable)
 *   - apple-touch-icon-180.png (180×180, opaque background, no alpha —
 *                               iOS rounds the corners automatically and
 *                               can't render transparency in home-screen
 *                               icons cleanly)
 *
 * Plus one file that belongs to neither set:
 *   - badge-96.png            (96×96, the Android notification badge —
 *                              SNOW-874. Alpha-only silhouette; see
 *                              buildBadge below for why it cannot be one
 *                              of the tiles.)
 *
 * Staging set (static/icons/pwa-staging/, SNOW-399) — same four files but
 * on an amber tile, with the mountain raised and the word "Staging" set in
 * a band beneath it. On the maskable variant every mark sits inside the
 * circle Android actually shows (see MASKABLE_MARK_RADIUS), so neither the
 * glyph nor the word is cropped.
 *
 * Snowdesk deploys the same codebase to staging (*.onrender.com) and
 * production (snowdesk.info). Once a tester has both installed as PWAs,
 * the two home-screen tiles look identical — this ships a launcher tile
 * that reads as unambiguously non-production from three feet away, so
 * staging sessions can't be confused for production ones.
 *
 * STAGING LABEL
 * -------------
 * The production tile is the favicon artwork and nothing else. The
 * staging tile lifts the mountain by MOUNTAIN_LIFT units of the 32-unit
 * viewBox and sets STAGING_LABEL in the band it vacates, so an installed
 * staging app says what it is without launching it. (Until SNOW-1112's
 * follow-up both tiles carried the season, "25/26", in that band, and
 * staging an asterisk off the mountain's top right; both were dropped.)
 *
 * Run via ``npm run build:icons`` (see package.json). The PNGs are
 * checked in alongside ``static/favicon.svg`` — when the SVG changes,
 * regenerate and commit the new outputs, then run
 * ``npm run build:splash`` so the iOS launch images follow.
 *
 * OPAQUE VARIANTS AND THE TILE COLOUR
 * -----------------------------------
 * Two of the four files are flattened onto an opaque backdrop rather
 * than keeping the SVG's transparent corners: the maskable PNG (which
 * shrinks the tile until every mark sits inside the circle Android shows,
 * so adaptive icon shapes and the launch splash don't crop the glyph) and the apple-touch icon
 * (iOS can't render transparency in home-screen icons cleanly).
 *
 * Both use the set's own TILE_COLOUR — the fill of the rounded rect in
 * the artwork itself — never the manifest background_color. Any other
 * choice shows as a visible border once the OS masks the icon: Android's
 * circular crop clips into the maskable padding at the cardinal edges,
 * and iOS's squircle leaves slivers at the corners of the apple-touch
 * icon. A backdrop that matches the tile makes those areas
 * indistinguishable from the icon's own rect. SNOW-151 established this for the
 * production maskable; the staging maskable (whose canvas, #7c2d12, was
 * a shade darker than its rect fill, #b45309) and the production
 * apple-touch icon (flattened onto the cream background_color) were
 * later fixed the same way.
 *
 * The flattened PNGs must be opaque (no alpha channel) — Android's
 * adaptive-icon mask leaks transparency at the masked corners if the
 * PNG retains an alpha channel, causing the logo to appear shrunken on
 * a white background. ``flatten`` composites transparent pixels onto
 * the supplied background colour; ``removeAlpha`` then drops the alpha
 * channel so the PNG encoder writes RGB (color_type 2) not RGBA
 * (color_type 6). Both steps are required under sharp >= 0.33 —
 * ``flatten`` alone no longer drops the channel.
 *
 * The purpose:any variants (192 and 512) keep their alpha: the browser
 * composites them itself and a transparent corner is correct there.
 *
 * Keep TILE_COLOUR_PRODUCTION / TILE_COLOUR_STAGING equal to the
 * tile_color fields in apps/public/site_environment.PWAEnvironmentIdentity.
 * The status bar no longer carries the environment (SNOW-1112: theme_color
 * equals the launch background on both), so the tile is the only tell.
 */

'use strict';

const fs = require('node:fs');
const path = require('node:path');
const sharp = require('sharp');

const REPO_ROOT = path.resolve(__dirname, '..');
const SRC_SVG = path.join(REPO_ROOT, 'static', 'favicon.svg');
const OUT_DIR_PROD = path.join(REPO_ROOT, 'static', 'icons', 'pwa');
const OUT_DIR_STAGING = path.join(REPO_ROOT, 'static', 'icons', 'pwa-staging');

// Brand green — must match the rect fill in static/favicon.svg. Doubles
// as the opaque backdrop for the production maskable and apple-touch
// PNGs, so a masked corner clips green-on-green (SNOW-151).
const TILE_COLOUR_PRODUCTION = '#2d4a3e';

// SNOW-399 — the staging tile colour, replacing the brand green in the
// recoloured artwork and backing the same two flattened PNGs. Mirrored as
// PWAEnvironmentIdentity.STAGING.tile_color in apps/public/site_environment.
const TILE_COLOUR_STAGING = '#b45309';

// Brand cream — must match the mountain fill in static/favicon.svg. The
// staging label reuses it so every light mark on the tile is the same
// white.
const FOREGROUND_COLOUR = '#f2f0ec';

// The radius, as a fraction of the maskable canvas, that every light mark
// on the tile (the mountain, and on staging the label) must sit inside.
// Android 12+ shows a maskable icon on its launch splash, and on a round
// launcher, as a circle two thirds of the canvas wide: radius 1/3. The
// W3C 80% safe zone is looser than that, which is how the old season
// label and staging asterisk came to be sliced off on the splash (SNOW-1112
// follow-up). 0.30 keeps a tenth of the circle as air around the marks.
const MASKABLE_MARK_RADIUS = 0.3;

// A pixel counts as a light mark when every channel is above this: the
// cream foreground is #f2f0ec, both tile colours are far darker.
const MARK_CHANNEL_MIN = 200;

// Units of the 32-unit viewBox the staging mountain is raised by to clear
// the label band at the foot of the tile.
const MOUNTAIN_LIFT = 4;

// The word in the staging band.
const STAGING_LABEL = 'Staging';

/**
 * Render the staging label as an SVG <text> element.
 *
 * Baseline y=29 of the 32-unit viewBox puts it in the band the lifted
 * mountain vacates. At font size 5.5 the word spans about two thirds of
 * the tile, leaving the rounded corners plenty of air. On the
 * maskable variant the word's ends are the furthest marks from the
 * centre, so they set how far the tile shrinks (see buildMaskable).
 */
function labelBand(label) {
  return (
    `<text x="16" y="29" font-family="Arial, Helvetica, sans-serif"` +
    ` font-size="5.5" font-weight="700" text-anchor="middle"` +
    ` fill="${FOREGROUND_COLOUR}">${label}</text>`
  );
}

/**
 * Read the checked-in production favicon SVG and, for the staging set,
 * recolour its tile, lift the mountain and set the label beneath it.
 *
 * The production tile is the favicon unchanged. The string replacements
 * target the exact production shape (see the check in main()); a future
 * SVG rewrite that changes it surfaces as a build-time mismatch, not a
 * silent no-op.
 */
function loadSourceSvg(variant) {
  const svg = fs.readFileSync(SRC_SVG, 'utf8');
  if (variant === 'production') {
    return Buffer.from(svg, 'utf8');
  }
  const staged = svg
    .replace('<path ', `<path transform="translate(0 -${MOUNTAIN_LIFT})" `)
    .replace(`fill="${TILE_COLOUR_PRODUCTION}"`, `fill="${TILE_COLOUR_STAGING}"`)
    .replace('</svg>', `${labelBand(STAGING_LABEL)}</svg>`);
  return Buffer.from(staged, 'utf8');
}

async function buildAny(size, outName, outDir, srcSvg) {
  const outPath = path.join(outDir, outName);
  await sharp(srcSvg).resize(size, size).png().toFile(outPath);
  console.log(`wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, any)`);
}

/**
 * Return the distance from the tile's centre to its furthest light mark,
 * as a fraction of the tile's width.
 *
 * Measured off a render rather than worked out from the SVG, because the
 * marks include text whose extent depends on the font: the label is the
 * widest thing on the tile and its corners are what the circle clips.
 */
async function markRadius(srcSvg) {
  const probe = 512;
  const { data, info } = await sharp(srcSvg)
    .resize(probe, probe)
    .ensureAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });
  let furthest = 0;
  for (let y = 0; y < info.height; y += 1) {
    for (let x = 0; x < info.width; x += 1) {
      const i = (y * info.width + x) * info.channels;
      const light =
        data[i + 3] > 128 &&
        data[i] > MARK_CHANNEL_MIN &&
        data[i + 1] > MARK_CHANNEL_MIN &&
        data[i + 2] > MARK_CHANNEL_MIN;
      if (light) {
        const dx = x + 0.5 - info.width / 2;
        const dy = y + 0.5 - info.height / 2;
        furthest = Math.max(furthest, Math.hypot(dx, dy));
      }
    }
  }
  return furthest / probe;
}

async function buildMaskable(size, outName, outDir, srcSvg, tileColour) {
  const outPath = path.join(outDir, outName);
  // Scale the whole tile so its furthest mark lands on
  // MASKABLE_MARK_RADIUS. The staging label reaches further out than the
  // bare mountain, so the staging glyph comes out a little smaller; that
  // is the price of the word surviving the crop.
  const ratio = MASKABLE_MARK_RADIUS / (await markRadius(srcSvg));
  const inner = Math.round(size * ratio);
  const pad = Math.round((size - inner) / 2);
  const innerBuffer = await sharp(srcSvg).resize(inner, inner).png().toBuffer();
  await sharp({
    create: {
      width: size,
      height: size,
      channels: 4,
      background: tileColour,
    },
  })
    .composite([{ input: innerBuffer, top: pad, left: pad }])
    // Flatten fills transparent areas with the tile colour, then
    // removeAlpha drops the alpha channel entirely so the PNG is written
    // as RGB (color_type 2) not RGBA (color_type 6). Both steps are needed:
    // flatten alone doesn't drop the channel in sharp >= 0.33; removeAlpha
    // alone would fill with black. Together they ensure Android's adaptive-
    // icon mask doesn't leak transparency at the masked corners.
    .flatten({ background: tileColour })
    .removeAlpha()
    .png()
    .toFile(outPath);
  console.log(
    `wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, maskable, tile at ${Math.round(ratio * 100)}%)`,
  );
}

async function buildAppleTouchIcon(size, outName, outDir, srcSvg, tileColour) {
  const outPath = path.join(outDir, outName);
  // iOS home-screen icons cannot be transparent — flatten the SVG over
  // the tile colour so the corners iOS's squircle mask leaves behind
  // clip tile-on-tile rather than showing a lighter fringe. ``flatten``
  // composites transparent pixels onto the background; ``removeAlpha``
  // then drops the alpha channel so the PNG is written as opaque RGB
  // (color_type 2). Both steps are required under sharp >= 0.33 (see
  // buildMaskable).
  await sharp(srcSvg)
    .resize(size, size)
    .flatten({ background: tileColour })
    .removeAlpha()
    .png()
    .toFile(outPath);
  console.log(
    `wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, apple-touch, opaque)`,
  );
}

/**
 * Render the Android notification badge: the mountain glyph alone, white
 * on transparent.
 *
 * SNOW-874. Android draws a notification's ``badge`` in the status bar by
 * throwing away its colours and keeping only its alpha channel, then
 * tinting the result. Handing it one of the tiles — which is what the
 * service worker did — hands it a rounded rect with no transparency
 * anywhere inside it, so the silhouette Android extracts is the whole
 * square and the status bar shows a solid white block. Nothing reports an
 * error; the notification itself looks right, and only the status-bar
 * glyph is wrong.
 *
 * So the badge drops the rect and keeps the path. The fill is white by
 * convention only — Android never reads it, and the same file would
 * render identically if the mountain were magenta.
 *
 * The viewBox is a 26-unit square centred on the glyph's bounding box
 * (x 5..27, y 10..25 of the source's 32-unit canvas), which trims the
 * tile's padding: at 24dp in a status bar the glyph needs the whole
 * canvas to read as mountains rather than as a smudge.
 *
 * There is no staging variant. The badge is an alpha mask, so the amber
 * tile colour cannot survive into it and the label would be a few
 * illegible pixels — a staging badge would be byte-identical in every way
 * that reaches the screen.
 */
async function buildBadge(size, outName, outDir) {
  const outPath = path.join(outDir, outName);
  const svg = fs.readFileSync(SRC_SVG, 'utf8');
  const glyph = /<path [^>]*\/>/.exec(svg);
  if (!glyph) {
    throw new Error('no <path> found in static/favicon.svg for the badge');
  }
  const badgeSvg = Buffer.from(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="3 4.5 26 26">' +
      `${glyph[0].replace(/fill="[^"]*"/, 'fill="#ffffff"')}</svg>`,
    'utf8',
  );
  await sharp(badgeSvg).resize(size, size).png().toFile(outPath);
  console.log(
    `wrote ${path.relative(REPO_ROOT, outPath)} (${size}×${size}, badge, alpha-only)`,
  );
}

async function buildSet({ variant, outDir, tileColour }) {
  fs.mkdirSync(outDir, { recursive: true });
  const srcSvg = loadSourceSvg(variant);
  await buildAny(192, 'icon-192.png', outDir, srcSvg);
  await buildAny(512, 'icon-512.png', outDir, srcSvg);
  await buildMaskable(512, 'icon-maskable-512.png', outDir, srcSvg, tileColour);
  await buildAppleTouchIcon(180, 'apple-touch-icon-180.png', outDir, srcSvg, tileColour);
}

async function main() {
  if (!fs.existsSync(SRC_SVG)) {
    console.error(`source SVG not found: ${SRC_SVG}`);
    process.exit(1);
  }
  // The staging recolour and the mountain lift depend on the exact
  // production SVG shape. Guard here so a future SVG rewrite surfaces as
  // a build error rather than a silent no-op that ships an amber-less
  // staging tile or a mountain overlapping the staging label.
  const svg = fs.readFileSync(SRC_SVG, 'utf8');
  if (!svg.includes(`fill="${TILE_COLOUR_PRODUCTION}"`)) {
    console.error(
      `expected fill="${TILE_COLOUR_PRODUCTION}" in static/favicon.svg — update` +
        ' TILE_COLOUR_PRODUCTION if the brand colour has moved',
    );
    process.exit(1);
  }
  if (!svg.includes('<path ')) {
    console.error(
      'expected a single <path> (the mountain glyph) in static/favicon.svg —' +
        ' update the staging lift in loadSourceSvg() if the artwork has changed',
    );
    process.exit(1);
  }

  await buildSet({
    variant: 'production',
    outDir: OUT_DIR_PROD,
    tileColour: TILE_COLOUR_PRODUCTION,
  });
  await buildSet({
    variant: 'staging',
    outDir: OUT_DIR_STAGING,
    tileColour: TILE_COLOUR_STAGING,
  });
  // One badge, in the production directory, for both environments —
  // static/js/sw.js reads it by that path whichever host it is running on.
  await buildBadge(96, 'badge-96.png', OUT_DIR_PROD);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
