<script>
const DATA = __DATA__;
const fmt = n => n.toLocaleString('en-GB');
const kfmt = n => Math.abs(n) >= 1000 ? (n / 1000) + 'k' : String(n);

/* Round a maximum up to a readable axis top. */
function niceMax(v) {
  if (v <= 0) return 1;
  const p = Math.pow(10, Math.floor(Math.log10(v)));
  for (const m of [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10]) if (p * m >= v) return p * m;
  return p * 10;
}

const T = {
  commits: DATA.reduce((s,d)=>s+d.c,0),
  rel: DATA.reduce((s,d)=>s+d.rel,0),
  add: DATA.reduce((s,d)=>s+d.a,0),
  del: DATA.reduce((s,d)=>s+d.d,0),
  gen: DATA.reduce((s,d)=>s+d.g,0),
};
const peakC = DATA.reduce((m,d)=>d.c>m.c?d:m);
const peakK = DATA.reduce((m,d)=>(d.a+d.d)>(m.a+m.d)?d:m);
const firstRel = DATA.find(d=>d.rel>0);

document.getElementById('tiles').innerHTML = [
  ['Commits merged', fmt(T.commits), (T.commits/DATA.length).toFixed(1) + ' / week average'],
  ['Releases cut', fmt(T.rel), firstRel ? 'first on ' + firstRel.label : 'none yet'],
  ['Lines added', fmt(T.add), 'peak ' + fmt(peakK.a) + ' · ' + peakK.label],
  ['Lines removed', fmt(T.del), T.add ? Math.round(100*T.del/T.add) + '% of what was added' : '—'],
  ['Busiest week', fmt(peakC.c) + ' commits', 'week of ' + peakC.label]
].map(([k,v,s]) => `<div class="tile"><dt>${k}</dt><dd>${v}</dd><span class="sub">${s}</span></div>`).join('');

/* Shared geometry — all three panels use the same x scale so the columns line up. */
const W = 960, PADL = 56, PADR = 14;
const PLOT = W - PADL - PADR;
const BAND = PLOT / DATA.length;
const BARW = Math.max(3, Math.min(28, BAND - 11));
const cx = i => PADL + BAND * i + BAND / 2;
const bx = i => cx(i) - BARW / 2;

/* Rounded only at the far end from the baseline. */
function bar(x, y, w, h, dir) {
  if (h <= 0) return '';
  const r = Math.min(4, h, w / 2);
  return dir === 'up'
    ? `M${x} ${y+h}V${y+r}A${r} ${r} 0 0 1 ${x+r} ${y}H${x+w-r}A${r} ${r} 0 0 1 ${x+w} ${y+r}V${y+h}Z`
    : `M${x} ${y}V${y+h-r}A${r} ${r} 0 0 0 ${x+r} ${y+h}H${x+w-r}A${r} ${r} 0 0 0 ${x+w} ${y+h-r}V${y}Z`;
}
const monthStart = DATA.map((d,i) => i === 0 || d.start.slice(5,7) !== DATA[i-1].start.slice(5,7));

function xAxis(y, labels) {
  let s = `<line class="zeroline" x1="${PADL}" y1="${y}" x2="${W-PADR}" y2="${y}"/>`;
  DATA.forEach((d,i) => {
    const isM = monthStart[i];
    s += `<line class="gridline" x1="${cx(i).toFixed(1)}" y1="${y}" x2="${cx(i).toFixed(1)}" y2="${y + (isM ? 7 : 4)}"/>`;
    if (isM && labels) s += `<text class="axtext month" x="${cx(i).toFixed(1)}" y="${y+21}" text-anchor="middle">${d.label}</text>`;
  });
  return s;
}
function hits(top, bot) {
  return DATA.map((d,i) =>
    `<rect class="col-hi" data-hi="${i}" x="${(PADL+BAND*i).toFixed(1)}" y="${top}" width="${BAND.toFixed(1)}" height="${bot-top}" rx="3"/>` +
    `<rect class="col-hit" data-i="${i}" x="${(PADL+BAND*i).toFixed(1)}" y="${top}" width="${BAND.toFixed(1)}" height="${bot-top}"/>`
  ).join('');
}
function yTick(y, text) {
  return `<text class="axtext" x="${PADL-10}" y="${(y+3.5).toFixed(1)}" text-anchor="end">${text}</text>`;
}

/* Panel 1 — churn, diverging from a zero line. */
(function(){
  const TOP = 12, H = 214;
  const ADDMAX = niceMax(Math.max(...DATA.map(d=>d.a)));
  const DELMAX = niceMax(Math.max(...DATA.map(d=>d.d)));
  const k = H / (ADDMAX + DELMAX);
  const ZERO = TOP + ADDMAX * k;
  let s = '';
  [ADDMAX, ADDMAX/2, 0, -DELMAX/2, -DELMAX].forEach(v => {
    const y = ZERO - v * k;
    s += `<line class="${v===0?'zeroline':'gridline'}" x1="${PADL}" y1="${y.toFixed(1)}" x2="${W-PADR}" y2="${y.toFixed(1)}"/>`;
    s += yTick(y, kfmt(Math.abs(v)));
  });
  DATA.forEach((d,i) => {
    s += `<path class="mark" data-m="${i}" fill="var(--add)" d="${bar(bx(i), ZERO - d.a*k, BARW, d.a*k, 'up')}"/>`;
    s += `<path class="mark" data-m="${i}" fill="var(--del)" d="${bar(bx(i), ZERO + 2, BARW, d.d*k, 'down')}"/>`;
  });
  s += hits(TOP, ZERO + DELMAX*k);
  document.getElementById('p-churn').innerHTML = s;
})();

/* Panel 2 — commits. */
(function(){
  const TOP = 12, H = 86, MAX = niceMax(Math.max(...DATA.map(d=>d.c))), BASE = TOP + H, k = H / MAX;
  let s = '';
  [MAX, MAX/2].forEach(v => {
    const y = BASE - v*k;
    s += `<line class="gridline" x1="${PADL}" y1="${y}" x2="${W-PADR}" y2="${y}"/>` + yTick(y, kfmt(v));
  });
  s += yTick(BASE, '0');
  DATA.forEach((d,i) => {
    s += `<path class="mark" data-m="${i}" fill="var(--commit)" d="${bar(bx(i), BASE - d.c*k, BARW, d.c*k, 'up')}"/>`;
  });
  s += xAxis(BASE, false) + hits(TOP, BASE);
  document.getElementById('p-commits').innerHTML = s;
})();

/* Panel 3 — releases. */
(function(){
  const TOP = 12, H = 56, MAX = niceMax(Math.max(...DATA.map(d=>d.rel))), BASE = TOP + H, k = H / MAX;
  let s = '';
  [MAX, MAX/2].forEach(v => {
    const y = BASE - v*k;
    s += `<line class="gridline" x1="${PADL}" y1="${y}" x2="${W-PADR}" y2="${y}"/>` + yTick(y, kfmt(v));
  });
  s += yTick(BASE, '0');
  DATA.forEach((d,i) => {
    s += `<path class="mark" data-m="${i}" fill="var(--release)" d="${bar(bx(i), BASE - d.rel*k, BARW, d.rel*k, 'up')}"/>`;
  });
  if (firstRel) s += `<text class="zero-note" x="${PADL+4}" y="${BASE-6}">no release branch before ${firstRel.label}</text>`;
  s += xAxis(BASE, true) + hits(TOP, BASE);
  document.getElementById('p-releases').innerHTML = s;
})();

/* One crosshair across all three panels. */
const charts = document.getElementById('charts');
const tip = document.getElementById('tip');
const svgs = [...charts.querySelectorAll('.plot')];
let active = -1;

function show(i, evt) {
  if (i === active) { place(evt); return; }
  active = i;
  const d = DATA[i];
  svgs.forEach(sv => {
    sv.classList.add('dim');
    sv.querySelectorAll('[data-hi]').forEach(e => e.classList.toggle('on', +e.dataset.hi === i));
    sv.querySelectorAll('[data-m]').forEach(e => e.classList.toggle('on', +e.dataset.m === i));
  });
  const rows = [
    ['commits', fmt(d.c)], ['releases', fmt(d.rel)],
    ['added', '+' + fmt(d.a)], ['removed', '−' + fmt(d.d)],
    ['files touched', fmt(d.f)]
  ].map(([k,v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('');
  tip.innerHTML = `<h3>Week of ${d.label} <span style="color:var(--ink-3);font-weight:400">· ${d.w.split('-')[1]}</span></h3><dl>${rows}</dl>` +
    (d.tags.length ? `<p class="tags">${d.tags.join(' · ')}</p>` : (d.c === 0 ? `<p class="tags">no commits this week</p>` : ''));
  tip.classList.add('on');
  place(evt);
}
function place(evt) {
  const r = charts.getBoundingClientRect();
  let x = evt.clientX - r.left, y = evt.clientY - r.top - 14;
  const w = tip.offsetWidth;
  x = Math.max(w/2 + 6, Math.min(r.width - w/2 - 6, x));
  if (y < tip.offsetHeight + 8) y = evt.clientY - r.top + tip.offsetHeight + 22;
  tip.style.left = x + 'px'; tip.style.top = y + 'px';
}
function clear() {
  active = -1;
  svgs.forEach(sv => {
    sv.classList.remove('dim');
    sv.querySelectorAll('.on').forEach(e => e.classList.remove('on'));
  });
  tip.classList.remove('on');
}
svgs.forEach(sv => {
  sv.addEventListener('pointermove', e => {
    const hit = e.target.closest('[data-i]');
    if (hit) show(+hit.dataset.i, e); else clear();
  });
  sv.addEventListener('pointerleave', clear);
});
charts.addEventListener('pointerleave', clear);

document.getElementById('tbody').innerHTML = DATA.map(d =>
  `<tr class="${d.c === 0 ? 'quiet' : ''}"><th scope="row">${d.label}</th><td>${fmt(d.c)}</td><td>${d.rel || '—'}</td>` +
  `<td class="add">${d.a ? '+' + fmt(d.a) : '—'}</td><td class="del">${d.d ? '−' + fmt(d.d) : '—'}</td>` +
  `<td>${d.f || '—'}</td><td>${d.g ? fmt(d.g) : '—'}</td></tr>`).join('');
document.getElementById('tfoot').innerHTML =
  `<tr><th scope="row">Total</th><td>${fmt(T.commits)}</td><td>${fmt(T.rel)}</td>` +
  `<td class="add">+${fmt(T.add)}</td><td class="del">−${fmt(T.del)}</td><td>—</td><td>${fmt(T.gen)}</td></tr>`;
</script>"""


def render(weeks: list[dict[str, object]], rendered_on: dt.date) -> str:
    """Render the churn page for a set of weekly records.

    Args:
        weeks: The weekly records, oldest first.
        rendered_on: Date stamped in the colophon.

    Returns:
        The complete HTML fragment.

    """
    loc, files = source_lines()
    first, last = weeks[0], weeks[-1]
    last_day = dt.date.fromisoformat(str(last["start"])) + dt.timedelta(days=6)
    eyebrow = (
        f"{pathlib.Path(REPO_ROOT).name} &nbsp;·&nbsp; "
        f"{dt.date.fromisoformat(str(first['start'])).strftime('%-d %b')} – "
        f"{min(last_day, rendered_on).strftime('%-d %b %Y')} &nbsp;·&nbsp; "
        f"{len(weeks)} ISO weeks"
    )
    sample = next(
        (str(w["tags"][0]) for w in weeks if w["tags"]),  # type: ignore[index]
        rendered_on.strftime("%Y.%m.%d"),
    )
    return (
        PAGE.replace("__DATA__", json.dumps(weeks, separators=(",", ":")))
        .replace("__NOTES__", notes(weeks, loc, files))
        .replace("__EYEBROW__", eyebrow)
        .replace("__SAMPLE_TAG__", sample)
        .replace("__RENDERED__", rendered_on.strftime("%-d %B %Y"))
    )


def main() -> int:
    """Render the churn page to stdout or to --output.

    Returns:
        Process exit code.

    """
    parser = argparse.ArgumentParser(description="Render the weekly churn chart.")
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        help="write the page here instead of stdout",
    )
    parser.add_argument(
        "--date",
        type=dt.date.fromisoformat,
        default=dt.date.today(),
        help="date stamped on the page (default: today)",
    )
    args = parser.parse_args()

    weeks = weekly_history()
    if not weeks:
        print("No commits found — run from inside the repository.", file=sys.stderr)
        return 1

    # Strip trailing whitespace per line, for the same reason
    # bin/render-day-summary-matrix does: a generated file that disagrees with
    # the pre-commit hook churns against its own generator forever.
    page = "\n".join(line.rstrip() for line in render(weeks, args.date).split("\n"))
    if args.output is None:
        print(page)
    else:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(page, encoding="utf-8")
        print(
            f"Wrote {args.output} — {len(weeks)} weeks, {len(page):,} bytes",
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
