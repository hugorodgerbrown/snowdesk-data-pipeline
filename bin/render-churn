#!/usr/bin/env python3
# bin/render-churn — render the repository's own history as a churn chart.
#
# "How fast is this project moving, and is that changing?" is a question the
# repository can answer about itself, but only by hand: `git log --numstat`
# aggregated per week, releases counted off the date-stamped tags, and the
# generated data separated from the authored code so one fixture import does
# not flatten every real week against it.
#
# This renders exactly that — commits merged, releases cut, and lines added
# and removed per ISO week, on one shared weekly axis — and it computes every
# figure on the page from git rather than carrying any of them as prose. A
# week that merges nothing shows up as a zero bar, not as a gap in the axis.
#
# Nothing here is authored, so nothing is committed: the page is a projection
# of the history, and re-running it is how it is kept current. That is the
# same reasoning as bin/render-day-summary-matrix, and the opposite of
# docs/page-audits/, which commits dated files because an audit is judgement
# that cannot be regenerated.
#
# The output is a self-contained HTML fragment — no <!doctype>, <html>,
# <head> or <body> of its own — the same convention as
# bin/render-day-summary-matrix and bin/render-testing-scenarios, so it
# publishes as an Artifact and still renders opened straight from disk.
#
# Reads only. Prints to stdout unless --output names a file.
#
#     uv run python bin/render-churn --output /tmp/churn.html
#
# ruff: noqa: T201, E501
# T201 — CLI script; print() is the intended output channel.
# E501 — most of this file is an embedded HTML document. Rewrapping its
#        markup and CSS to 88 columns to satisfy a Python line-length rule
#        would damage the output for no reader's benefit, which is the same
#        reasoning bin/render-day-summary-matrix's header gives.

"""Weekly churn renderer — see the header block above for full behaviour."""

from __future__ import annotations

import argparse
import collections
import datetime as dt
import json
import pathlib
import re
import shutil
import subprocess
import sys

REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
# Resolved once, so the subprocess call names an absolute executable.
GIT = shutil.which("git") or "git"

# Paths whose churn is data moving, not work being done. Counted, reported in
# its own column, and kept out of the chart: without this, PR #153 (the EAWS
# micro-region polygons for AT and IT) puts a 600k-line spike on one week and
# every other week reads as flat against it.
GENERATED = re.compile(
    r"(^|/)fixtures/"
    r"|(^|/)(uv\.lock|package-lock\.json|poetry\.lock)$"
    r"|\.(po|mo)$"
    r"|^sample_data/"
    r"|^static/css/output\.css$"
    r"|\.ndjson$"
    r"|^docs/archive_pdfs/"
)

# A release is a date-stamped tag cut from `release` (2026.08.30, and .2 for a
# second cut the same day). The spike and recovery tags carry names, not dates,
# and are not releases.
RELEASE_TAG = re.compile(r"^\d{4}\.\d{2}\.\d{2}(\.\d+)?$")

# What counts as hand-written for the closing "how much of it survived"
# comparison. Deliberately narrower than the churn set: this is a headline
# figure, not an audit, and it should read as code, tests, templates and docs.
SOURCE_GLOBS = ("*.py", "*.js", "*.html", "*.css", "*.md")


def git(*args: str) -> str:
    """Run a read-only git command in the repo and return its stdout.

    Args:
        *args: Arguments after `git` itself.

    Returns:
        Captured stdout, trailing newline stripped.

    """
    # S603 — the argument list is built from module constants, passed as a
    # list with no shell. There is no injection surface.
    result = subprocess.run(  # noqa: S603
        [GIT, "-C", str(REPO_ROOT), *args],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout.rstrip("\n")


def iso_week(day: dt.date) -> str:
    """Return the ISO year-week key (e.g. ``2026-W35``) a date falls in.

    Args:
        day: The date to bucket.

    Returns:
        The ISO week key.

    """
    return day.strftime("%G-W%V")


def _week_monday(key: str) -> dt.date:
    """Return the Monday of an ISO week key such as ``2026-W35``.

    Args:
        key: The week key.

    Returns:
        That week's Monday.

    """
    return dt.date.fromisocalendar(int(key[:4]), int(key[6:]), 1)


def release_weeks() -> dict[str, list[str]]:
    """Map each ISO week to the release tags cut in it.

    Returns:
        Week key to sorted tag names. Weeks with no release are absent.

    """
    weeks: dict[str, list[str]] = collections.defaultdict(list)
    raw = git(
        "for-each-ref", "--format=%(refname:short)\t%(creatordate:short)", "refs/tags"
    )
    for line in raw.splitlines():
        if not line.strip():
            continue
        name, created = line.split("\t")
        if RELEASE_TAG.match(name):
            weeks[iso_week(dt.date.fromisoformat(created))].append(name)
    return {week: sorted(tags) for week, tags in weeks.items()}


def _empty_week() -> dict[str, object]:
    """Return a zeroed accumulator for one week.

    Returns:
        A fresh bucket. `files` is a set so a file touched by three commits
        in one week counts once.

    """
    return {"commits": 0, "add": 0, "dele": 0, "gen": 0, "files": set()}


def _accumulate(raw: str) -> dict[str, dict[str, object]]:
    """Fold `git log --numstat` output into one accumulator per ISO week.

    Args:
        raw: Output of the log command, commits introduced by a `C <date>`
            line and followed by their numstat rows.

    Returns:
        Week key to accumulator. Weeks that merged nothing are absent — the
        calendar walk in `weekly_history` fills them back in.

    """
    buckets: dict[str, dict[str, object]] = collections.defaultdict(_empty_week)
    current: str | None = None

    for line in raw.splitlines():
        if line.startswith("C "):
            current = iso_week(dt.date.fromisoformat(line[2:].strip()))
            buckets[current]["commits"] += 1  # type: ignore[operator]
            continue
        parts = line.split("\t")
        # A numstat row is added/removed/path; "-" in place of a count is
        # git's marker for a binary file, which has no lines to attribute.
        if current is None or len(parts) != 3 or parts[0] == "-":
            continue
        added, removed, path = parts
        bucket = buckets[current]
        if GENERATED.search(path):
            bucket["gen"] += int(added) + int(removed)  # type: ignore[operator]
        else:
            bucket["add"] += int(added)  # type: ignore[operator]
            bucket["dele"] += int(removed)  # type: ignore[operator]
            bucket["files"].add(path)  # type: ignore[union-attr]
    return buckets


def weekly_history() -> list[dict[str, object]]:
    """Aggregate the first-parent history into one record per ISO week.

    Every commit on the default branch is a squash merge, so first-parent
    history counts each merged pull request exactly once. Weeks between the
    first and last commit that merged nothing are included with zero counts —
    a gap in the timeline is part of the picture, not something to drop.

    Returns:
        One dict per week, oldest first, each carrying commits, releases,
        lines added and removed, files touched, and generated-data churn.

    """
    buckets = _accumulate(
        git("log", "--first-parent", "--format=C %ad", "--date=short", "--numstat")
    )
    if not buckets:
        return []

    releases = release_weeks()
    monday = _week_monday(min(buckets))
    end = _week_monday(max(buckets))

    weeks: list[dict[str, object]] = []
    while monday <= end:
        key = iso_week(monday)
        bucket = buckets.get(key, _empty_week())
        weeks.append(
            {
                "w": key,
                "start": monday.isoformat(),
                "label": monday.strftime("%-d %b"),
                "c": bucket["commits"],
                "rel": len(releases.get(key, [])),
                "a": bucket["add"],
                "d": bucket["dele"],
                "f": len(bucket["files"]),  # type: ignore[arg-type]
                "g": bucket["gen"],
                "tags": releases.get(key, []),
            }
        )
        monday += dt.timedelta(days=7)
    return weeks


def source_lines() -> tuple[int, int]:
    """Count the hand-written lines tracked in the working tree today.

    Migrations and the compiled stylesheet are excluded: neither is written
    by hand, and both would inflate a figure whose whole job is to be
    compared against how much was typed.

    Returns:
        A (lines, files) pair.

    """
    paths = [
        p
        for p in git("ls-files", *SOURCE_GLOBS).splitlines()
        if p and "/migrations/" not in p and not p.endswith("static/css/output.css")
    ]
    lines = 0
    for path in paths:
        full = REPO_ROOT / path
        try:
            lines += sum(1 for _ in full.open("rb"))
        except OSError:  # a tracked file that is not on disk right now
            continue
    return lines, len(paths)


def notes(weeks: list[dict[str, object]], loc: int, files: int) -> str:
    """Render the "how this was counted" list, with every figure computed.

    Args:
        weeks: The weekly records.
        loc: Hand-written lines tracked today.
        files: How many files those lines are spread across.

    Returns:
        An HTML `<li>` sequence.

    """
    total_add = sum(int(w["a"]) for w in weeks)  # type: ignore[arg-type]
    total_del = sum(int(w["d"]) for w in weeks)  # type: ignore[arg-type]
    silent = [w for w in weeks if w["c"] == 0]
    worst_gen = max(weeks, key=lambda w: int(w["g"]))  # type: ignore[arg-type]
    first_release = next((w for w in weeks if w["rel"]), None)

    items = [
        "<b>Churn</b> is <code>git log --numstat</code> summed per ISO week over "
        "first-parent history. Every commit on the default branch is a squash "
        "merge, so one commit is one merged pull request and nothing is counted "
        "twice.",
        "<b>Excluded from churn</b> and reported in the last column: "
        "<code>fixtures/</code>, <code>sample_data/</code>, <code>uv.lock</code>, "
        "<code>package-lock.json</code>, <code>.po</code>/<code>.mo</code> "
        "catalogues, <code>output.css</code>, <code>.ndjson</code> archives and "
        "the archived bulletin PDFs. That is data moving, not work being done — "
        f"the week of {worst_gen['label']} alone carries "
        f"{int(worst_gen['g']):,} lines of it, "  # type: ignore[arg-type]
        "which without the exclusion would flatten every other week on the chart.",
    ]
    if silent:
        names = " and ".join(str(w["label"]) for w in silent)
        items.append(
            f"<b>{'Two silent weeks' if len(silent) == 2 else 'Silent weeks'}.</b> "
            f"{names} carr{'y' if len(silent) != 1 else 'ies'} no commits at all; "
            "the bars are drawn at zero rather than dropped, so the timeline stays "
            "honest about the gaps."
        )
    if first_release is not None:
        before = weeks.index(first_release)
        items.append(
            f"<b>Releases begin in week {before + 1}.</b> Everything before "
            f"{first_release['label']} predates the release branch, so the release "
            "panel is empty there by construction, not by inactivity."
        )
    items.append(
        f"<b>Where it landed.</b> {total_add:,} lines added against {total_del:,} "
        f"removed leaves ~{(total_add - total_del) // 1000:,}k net, against "
        f"{loc:,} lines of code, tests, templates and docs tracked across {files:,} "
        "files today — so a meaningful share of everything written has since been "
        "rewritten or deleted."
    )
    return "\n      ".join(f"<li>{item}</li>" for item in items)


