#!/usr/bin/env node
/*
 * bin/build-vector-tile-kit — Rebuild static/js/vector_tile_kit.min.js
 * (SNOW-1460).
 *
 * The winter map past the Swiss border reads OpenStreetMap vector tiles
 * through the `osmclip://` protocol, whose worker (static/js/osm_clip_worker.js)
 * decodes each tile, clips it to outside the swisstopo extent and encodes it
 * again. Those three steps, and the polygon clipping, are four npm packages
 * pinned exactly in package.json's devDependencies:
 *
 *   pbf                 the protocol-buffer reader and writer
 *   @mapbox/vector-tile the Mapbox Vector Tile decoder
 *   vt-pbf              the Mapbox Vector Tile encoder
 *   polygon-clipping    boolean operations on polygons
 *
 * This joins them, with what they import, into ONE classic-script IIFE that
 * publishes a frozen `self.VectorTileKit = { Pbf, VectorTile, vtpbf,
 * polygonClipping }`. A worker loads it with `importScripts`, and Vitest
 * loads the same file, so the tests run the code the browser runs.
 *
 * The output is generated, minified and COMMITTED, like
 * static/js/maplibre-gl.min.js: bin/minify-js leaves `*.min.js` alone, and
 * bin/ds-lint, bin/i18n-lint and bin/js-globals-lint name it as vendored.
 * Its header names every package bundled into it, with its version and
 * licence; static/js/vector_tile_kit.LICENSES.md carries the licence texts.
 *
 * Usage, after changing a pinned version:
 *   npm install
 *   node bin/build-vector-tile-kit
 */

const fs = require('node:fs');
const path = require('node:path');
const esbuild = require('esbuild');

const ROOT = path.resolve(__dirname, '..');
const OUT = path.join(ROOT, 'static', 'js', 'vector_tile_kit.min.js');

/** The packages the kit is made from, as package.json pins them. */
const DIRECT = ['pbf', '@mapbox/vector-tile', 'vt-pbf', 'polygon-clipping'];

const ENTRY = `
  import Pbf from 'pbf';
  import { VectorTile } from '@mapbox/vector-tile';
  import vtpbf from 'vt-pbf';
  import polygonClipping from 'polygon-clipping';
  self.VectorTileKit = Object.freeze({ Pbf, VectorTile, vtpbf, polygonClipping });
`;

/**
 * The package a bundled input path belongs to, read from its node_modules
 * path: `node_modules/@scope/name/...` or `node_modules/name/...`.
 *
 * @param {string} input
 * @returns {string|null}
 */
function packageOf(input) {
  const match = /node_modules\/((?:@[^/]+\/)?[^/]+)\//.exec(input);
  return match ? match[1] : null;
}

async function main() {
  const result = await esbuild.build({
    stdin: { contents: ENTRY, resolveDir: ROOT, sourcefile: 'vector_tile_kit.entry.js' },
    bundle: true,
    format: 'iife',
    minify: true,
    target: 'es2019',
    platform: 'browser',
    // The ES builds, so each package's own dependencies (polygon-clipping's
    // splaytree and robust-predicates) are bundled from their own packages
    // and listed in the header, not hidden inside a UMD build.
    mainFields: ['module', 'main'],
    metafile: true,
    write: false,
    legalComments: 'none',
  });
  const packages = new Set();
  for (const input of Object.keys(result.metafile.inputs)) {
    const name = packageOf(input);
    if (name) packages.add(name);
  }
  for (const name of DIRECT) {
    if (!packages.has(name)) throw new Error(`build-vector-tile-kit: ${name} was not bundled`);
  }
  const lines = [...packages].sort().map((name) => {
    const meta = JSON.parse(
      fs.readFileSync(path.join(ROOT, 'node_modules', name, 'package.json'), 'utf8'),
    );
    return ` *   ${name}@${meta.version} (${meta.license})`;
  });
  const header = [
    '/*',
    ' * static/js/vector_tile_kit.min.js — GENERATED by bin/build-vector-tile-kit',
    ' * (SNOW-1460); do not edit. self.VectorTileKit = { Pbf, VectorTile, vtpbf,',
    ' * polygonClipping }, for static/js/osm_clip_worker.js. Bundles:',
    ...lines,
    ' * Licence texts: static/js/vector_tile_kit.LICENSES.md.',
    ' */',
    '',
  ].join('\n');
  fs.writeFileSync(OUT, header + result.outputFiles[0].text);
  console.log(`build-vector-tile-kit: wrote ${path.relative(ROOT, OUT)} (${packages.size} packages)`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
