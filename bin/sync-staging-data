#!/usr/bin/env bash
# bin/sync-staging-data — refresh staging's provider data from production.
#
# Replaces the row-by-row ORM copy SNOW-729 shipped (SNOW-736). That version
# pushed ~230 `INSERT … ON CONFLICT` statements through Django for
# bulletins_regionbulletin alone, building 59,085 model instances in Python
# on a starter dyno, and put the staging database into crash recovery.
# `COPY` moves the same rows in one statement per table, an order of
# magnitude faster and at a fraction of the server load.
#
# No user data is copied. `pg_dump --table=` names every table explicitly,
# so nothing personal enters the dump stream — the guarantee comes from not
# selecting those rows rather than from filtering them afterwards.
# locations_location is the one table holding curated and user rows side by
# side, and it is streamed through a filtered \copy instead.
#
# Three facts make this safe, each verified rather than assumed:
#
#   * regions_microregion primary keys are identical in both databases, so
#     COPY preserves production's foreign keys verbatim and every reference
#     still points at the right region. Re-checked on every run below,
#     because a mismatch would mis-attribute every bulletin *silently*.
#   * Rows are cleared with ordered DELETEs, not TRUNCATE. TRUNCATE's
#     foreign-key check is *structural*: it refuses while a referencing
#     constraint exists at all, however many rows actually use it. Since
#     regions_microregion.centroid_location_id references locations_location,
#     nothing in this set can be truncated without also truncating the region
#     table — which would cascade through most of the database. DELETE checks
#     actual rows instead, so releasing that one nullable column and deleting
#     children before parents is enough. It keeps the property that matters:
#     a table left out fails the run naming its constraint, rather than
#     quietly having its rows removed the way CASCADE would.
#   * Every table loaded here is populated on staging only by this script,
#     so clearing before loading is a refresh, not a loss.
#
# What it does clear, and does not restore: staging's own favourites, field
# observations and bulletin shares. They reference the copied tables, so
# they have to go. Staging's user accounts, passkeys and routes are NOT
# touched. See the runbook.
#
# Read-only by default; pass --commit to write.
# Runbook: docs/runbooks/refresh-staging-from-production.md

set -o errexit
set -o nounset
set -o pipefail

# Runtime strings stay ASCII. Under a non-UTF-8 locale bash absorbed the
# leading byte of a "…" into the preceding variable name — `echo "Loading
# $table…"` died with `table\xe2: unbound variable`, which `bash -n` cannot
# see because it is an expansion, not a syntax error. Prose punctuation is
# fine in comments; it is not fine next to an expansion. Expansions are
# braced throughout for the same reason.

COMMIT=0
for arg in "$@"; do
    case "$arg" in
        --commit) COMMIT=1 ;;
        -h | --help)
            sed -n '2,42p' "$0"
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 2
            ;;
    esac
done

: "${DATABASE_URL:?DATABASE_URL is not set}"
: "${PRODUCTION_DATABASE_URL:?PRODUCTION_DATABASE_URL is not set - see the runbook}"

# Load order, not alphabetical: a table's foreign-key parents come first.
# Django's foreign keys are DEFERRABLE INITIALLY DEFERRED, but each COPY runs
# in its own transaction here, so the checks fire per table and order counts.
#
# bulletins_pipelinerun leads because bulletins_bulletin.pipeline_run_id
# points at it. The ORM version nulled that column instead, because
# PipelineRun has no natural key to upsert on — a constraint that simply
# does not exist once COPY is preserving primary keys.
LOAD_ORDER=(
    bulletins_pipelinerun
    bulletins_bulletin
    locations_location
    regions_resort
    locations_resortlocation
    bulletins_regionbulletin
    bulletins_regiondayrating
    bulletins_bulletingrouping
    weather_weather
)

# Cleared but never reloaded: staging's own rows referencing the copied set.
# Listed children-first, and deleted before anything in LOAD_ORDER, because
# every one of them points into it.
CLEAR_ONLY=(
    bulletins_bulletinshareclick
    bulletins_bulletinshare
    favourites_favourite
    observations_fieldobservation
)

# Only rows a ResortLocation references are curated. apps/favourites/services.py
# and apps/observations/views.py mint the rest from user input, and those are
# never selected — so a saved position is not read out of production at all.
# Two kinds of curated Location, both safe and both needed:
#   * a resort's village / mid-station / peak, via locations_resortlocation;
#   * a region's centroid, via regions_microregion.centroid_location_id.
# Everything else in this table is a saved map pin or a field report, minted
# from user input, and is never selected.
CURATED_LOCATION_IDS="SELECT location_id FROM locations_resortlocation \
UNION SELECT centroid_location_id FROM regions_microregion \
WHERE centroid_location_id IS NOT NULL"

LOCATION_FILTER="SELECT * FROM locations_location \
WHERE id IN (${CURATED_LOCATION_IDS})"

# weather_weather is filtered by the same set, and must be: a Weather row
# whose location is a saved pin or a field report would arrive pointing at a
# locations_location row this script deliberately did not copy, and the
# \copy would fail on the foreign key. Restricting it here keeps the two
# filters provably in step — they read the same subquery.
WEATHER_FILTER="SELECT * FROM weather_weather \
WHERE location_id IN (${CURATED_LOCATION_IDS})"

# The production-side query for one table: whole table by default, filtered
# for the two that must not carry user-minted rows across. One function so
# the count preview and the load below cannot disagree about what is copied.
source_query() {
    case "$1" in
        locations_location) printf '%s' "$LOCATION_FILTER" ;;
        weather_weather) printf '%s' "$WEATHER_FILTER" ;;
        *) printf 'SELECT * FROM %s' "$1" ;;
    esac
}

psql_prod() { psql "$PRODUCTION_DATABASE_URL" -v ON_ERROR_STOP=1 -At "$@"; }
psql_local() { psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -At -q "$@"; }

# --- Refuse to run against the wrong database -------------------------------
# Compares host, port and database name; never touches the password.
python3 - <<'PY'
import os
import sys
from urllib.parse import urlsplit

local = urlsplit(os.environ["DATABASE_URL"])
prod = urlsplit(os.environ["PRODUCTION_DATABASE_URL"])
if (local.hostname, local.port, local.path) == (prod.hostname, prod.port, prod.path):
    sys.exit(
        "REFUSING: DATABASE_URL and PRODUCTION_DATABASE_URL are the same "
        "database. This script truncates its target."
    )
PY

# --- Verify the assumption the whole approach rests on ----------------------
REGION_HASH_SQL="SELECT md5(string_agg(id || ':' || region_id, ',' ORDER BY id)) \
FROM regions_microregion;"

if [[ "$(psql_prod -c "$REGION_HASH_SQL")" != "$(psql_local -c "$REGION_HASH_SQL")" ]]; then
    cat >&2 <<'MSG'
REFUSING: regions_microregion primary keys differ between the two databases.

COPY preserves production's region_id foreign keys verbatim, so mismatched
region ids would attach every bulletin to the wrong region - silently, with
no error and no failed row. Reconcile the region fixtures on both sides
first. See docs/runbooks/refresh-staging-from-production.md.
MSG
    exit 1
fi

echo "regions_microregion verified identical on both databases."
echo
printf '%-42s %12s %12s\n' "TABLE" "PRODUCTION" "STAGING"
for table in "${LOAD_ORDER[@]}"; do
    prod_count=$(psql_prod -c "SELECT count(*) FROM ($(source_query "$table")) f;")
    printf '%-42s %12s %12s\n' \
        "$table" "$prod_count" "$(psql_local -c "SELECT count(*) FROM ${table};")"
done
echo
echo "Will also be cleared and left empty: ${CLEAR_ONLY[*]}"
echo

if [[ "$COMMIT" -eq 0 ]]; then
    echo "[READ-ONLY] dry run - nothing written. Pass --commit to load."
    exit 0
fi

# --- Clear -------------------------------------------------------------------
# regions_microregion must survive, and it is the only surviving table that
# points into the set. Its reference is nullable, so release it first;
# link_region_centroid_locations rebuilds it at the end.
echo "Releasing region centroid references..."
psql_local -c "UPDATE regions_microregion SET centroid_location_id = NULL;" > /dev/null

# Children before parents, and CLEAR_ONLY before all of them. No CASCADE
# anywhere: a table left out of these lists fails the run naming its own
# constraint, which is the whole point.
echo "Clearing $(( ${#LOAD_ORDER[@]} + ${#CLEAR_ONLY[@]} )) table(s)..."
for table in "${CLEAR_ONLY[@]}"; do
    psql_local -c "DELETE FROM ${table};" > /dev/null
done
for (( i = ${#LOAD_ORDER[@]} - 1; i >= 0; i-- )); do
    psql_local -c "DELETE FROM ${LOAD_ORDER[i]};" > /dev/null
done

# --- Load --------------------------------------------------------------------
# \copy, not pg_dump. pg_dump --data-only also reads each table's owned
# sequence to emit a setval, so it needs SELECT on sequences as well as on
# tables and dies with
#
#   failed to get data for sequence "…_id_seq"; user may lack SELECT
#   privilege on the sequence
#
# against a role granted only SELECT on tables. \copy needs nothing beyond
# the table privilege the read-only role already has, drops the dependency on
# the client's version being >= the server's, and this script sets the
# sequences itself below — so pg_dump's setval was redundant anyway.
for table in "${LOAD_ORDER[@]}"; do
    echo "Loading ${table}..."
    psql "$PRODUCTION_DATABASE_URL" -v ON_ERROR_STOP=1 -q \
        -c "\copy ($(source_query "$table")) TO STDOUT" |
        psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -q \
            -c "\copy ${table} FROM STDIN"
done

# --- Reset sequences ---------------------------------------------------------
# The rows carried production's primary keys, which the local sequences know
# nothing about. The next INSERT would collide until they catch up.
echo "Resetting sequences..."
for table in "${LOAD_ORDER[@]}"; do
    psql_local -c "SELECT setval(
        pg_get_serial_sequence('${table}', 'id'),
        COALESCE((SELECT max(id) FROM ${table}), 1)
    );" > /dev/null
done

# --- Reclaim and re-plan -----------------------------------------------------
# DELETE leaves dead tuples behind, and this runs nightly over ~100k rows, so
# without a sweep the tables bloat steadily. ANALYZE matters just as much on
# its own: the planner's statistics describe the rows that were just deleted
# until something refreshes them.
echo "Vacuuming..."
for table in "${LOAD_ORDER[@]}"; do
    psql_local -c "VACUUM ANALYZE ${table};" > /dev/null
done

# --- Restore what the clear released ----------------------------------------
# Copy production's centroid links rather than recomputing them. The obvious
# alternative, `manage.py link_region_centroid_locations --commit`, is cheap
# now that it is wholly offline (SNOW-771 put the elevations in the fixture,
# so it reads `centroid_elevation_m` and makes no third-party call), but it
# would mint fresh Location rows in the ids this script has just loaded and
# re-sequenced.
#
# Copying is also more faithful: staging ends up pointing at the same
# centroids production does. It is safe because regions_microregion ids are
# verified identical above, and the Locations they name are in the copy set
# (see LOCATION_FILTER).
echo "Restoring region centroids..."
psql_prod -c "SELECT format(
    'UPDATE regions_microregion SET centroid_location_id=%s WHERE id=%s;',
    centroid_location_id, id
) FROM regions_microregion WHERE centroid_location_id IS NOT NULL;" |
    psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -q

echo
echo "Done. Staging holds production's bulletins, weather and resorts."
