#!/usr/bin/env bash
# bin/cut-release — Fast-forward `release` to `main` for a production deploy.
#
# Staging deploys on every merge to `main`; production deploys when the
# `release` branch advances. `release` behaves like a tag that moves with
# `main`: this script advances it by a **fast-forward** push, so the
# production commit is byte-identical to the `main` commit already verified
# on staging — no merge commit, no divergence, no separate PR.
#
#   git push origin origin/main:refs/heads/release
#
# The push is only allowed when `release` is an ancestor of `main` (a true
# fast-forward) and the target commit's required checks are already green —
# the "Release branch" GitHub ruleset enforces the latter, reusing the check
# runs from when the commit was on `main`. A red `main` therefore cannot be
# released, and `release` can only ever move forward.
#
# It prints the `SNOW-xx` tickets that are on `main` but not yet on
# `release` — i.e. the tickets this release ships. Those tickets already
# closed in Linear when they merged to `main`; the list is informational
# (the GitHub Release notes, generated by release.yml, are the shipped
# record).
#
# It also REFUSES to release when the tracked `VERSION` file has not moved
# since the last release. That file holds the release ordinal the app shows
# in the account menu ("v24"), and it is the one part of a release that
# nothing else can compute: Render's build gets `RENDER_GIT_COMMIT` and no
# tags, and release.yml creates the CalVer tag only after the deploy has
# started. Nothing else in the pipeline would notice a stale number, and
# the failure is silent and long-lived — every user reading the menu is
# told they are on the previous release. So the check lives here, at the
# one point every production release passes through.
#
# Dry-run by default — prints what it would push. Pass --commit to push.
#
# Usage:
#   bin/cut-release            # dry run: print target SHA + ticket list
#   bin/cut-release --commit   # fast-forward origin/release to origin/main
#
# Requires git and a push-authorised `origin` remote.

set -euo pipefail

COMMIT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --commit) COMMIT=1 ;;
        *)
            echo "Usage: $0 [--commit]" >&2
            exit 64  # EX_USAGE
            ;;
    esac
    shift
done

echo "Fetching origin (branches + tags)…"
git fetch origin --tags --quiet

if ! git rev-parse --verify --quiet origin/main >/dev/null; then
    echo "Error: origin/main not found." >&2
    exit 1
fi

MAIN_SHA="$(git rev-parse origin/main)"

# `release` may not exist yet (the very first release creates it at main).
# When it does exist, the advance MUST be a fast-forward — release has to be
# an ancestor of main. A non-fast-forward means someone advanced release
# out of band; refuse rather than force anything.
RELEASE_EXISTS=0
if git rev-parse --verify --quiet origin/release >/dev/null; then
    RELEASE_EXISTS=1
    if ! git merge-base --is-ancestor origin/release origin/main; then
        echo "Error: origin/release is not an ancestor of origin/main —" >&2
        echo "       the advance would not be a fast-forward. Reconcile" >&2
        echo "       release with main before releasing." >&2
        exit 1
    fi
    if [[ "$(git rev-parse origin/release)" == "$MAIN_SHA" ]]; then
        echo "origin/release already equals origin/main — nothing to release."
        exit 0
    fi
fi

# Determine the comparison base for the ticket list:
#   1. origin/release if it exists (the normal case);
#   2. else the most recent CalVer release tag (YYYY.MM.DD[.N]);
#   3. else nothing — this is the first release, so list every ticket.
BASE=""
if [[ "$RELEASE_EXISTS" -eq 1 ]]; then
    BASE="origin/release"
else
    LAST_TAG="$(git tag --list '20*.*.*' --sort=-creatordate | head -n1)"
    [[ -n "$LAST_TAG" ]] && BASE="$LAST_TAG"
fi

if [[ -n "$BASE" ]]; then
    RANGE="${BASE}..origin/main"
    echo "Comparing ${BASE} → origin/main"
else
    RANGE="origin/main"
    echo "No release branch or tag found — listing all tickets on origin/main"
fi

# The release ordinal must have moved since the last release, or the account
# menu will name the previous one. Compared between the two refs rather than
# against the working tree: what matters is the value origin/main will
# actually deploy, not whatever is checked out locally.
#
# Skipped when release does not exist yet — the first release has nothing to
# differ from, and any starting number is correct by definition.
if [[ "$RELEASE_EXISTS" -eq 1 ]]; then
    # `git show ref:path` fails when the file is absent on that ref, which is
    # the case for every release cut before VERSION existed. An unreadable
    # side is not a stale number, so treat it as "cannot compare" and let the
    # release through rather than blocking on history.
    MAIN_RELEASE="$(git show "origin/main:VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
    PREV_RELEASE="$(git show "origin/release:VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ -n "$MAIN_RELEASE" && -n "$PREV_RELEASE" && "$MAIN_RELEASE" == "$PREV_RELEASE" ]]; then
        echo "Error: VERSION is still ${MAIN_RELEASE} — the same as the last release." >&2
        echo "       The account menu would tell every user they are on v${MAIN_RELEASE}" >&2
        echo "       when they are on a newer build. Bump VERSION on main first:" >&2
        # Suggest the actual next number rather than an expression the
        # reader has to evaluate — but only when the current one is an
        # integer. The scheme could change; the guard should not start
        # printing arithmetic on a value it cannot add to.
        if [[ "$MAIN_RELEASE" =~ ^[0-9]+$ ]]; then
            echo "         echo $((MAIN_RELEASE + 1)) > VERSION" >&2
        else
            echo "         (VERSION currently reads '${MAIN_RELEASE}')" >&2
        fi
        echo "       then open a PR for it and re-run this script." >&2
        exit 1
    fi
    if [[ -n "$MAIN_RELEASE" ]]; then
        echo "Release number: v${PREV_RELEASE:-?} → v${MAIN_RELEASE}"
    fi
fi

# Extract unique SNOW-xx references from the commit subjects in range.
TICKETS="$(git log "$RANGE" --format='%s' \
    | grep -oE 'SNOW-[0-9]+' \
    | sort -u -t- -k2 -n || true)"

if [[ -n "$TICKETS" ]]; then
    TICKET_LINES="$(while read -r t; do echo "  - ${t}"; done <<<"$TICKETS")"
else
    TICKET_LINES="  - (no SNOW tickets found in range)"
fi

echo
echo "Tickets in this release:"
echo "$TICKET_LINES"
echo

if [[ "$COMMIT" -eq 0 ]]; then
    echo "DRY RUN — would fast-forward release (pass --commit to do it):"
    echo "  ref:    origin/release → ${MAIN_SHA:0:12}  (origin/main)"
    [[ "$RELEASE_EXISTS" -eq 0 ]] && echo "  note:   origin/release does not exist yet — this push creates it"
    echo
    echo "  git push origin origin/main:refs/heads/release"
    exit 0
fi

echo "Fast-forwarding origin/release to origin/main (${MAIN_SHA:0:12})…"
git push origin "origin/main:refs/heads/release"
echo "Done. Render will redeploy the production services from the new release tip;"
echo "release.yml will tag the commit and create the GitHub Release."
