#!/usr/bin/env bash
# bin/cut-release — Open the pull request that ships `main` to production.
#
# Staging deploys on every merge to `main`; production deploys when the
# `release` branch advances. `release` behaves like a tag that moves with
# `main` — it only ever fast-forwards to a `main` commit, so the production
# commit is byte-identical to the one already verified on staging.
#
# This script does NOT touch `release`. It opens a **release PR** against
# `main` carrying one commit — the `VERSION` bump — and a description
# summarising every ticket the release will ship. Merging that PR is the
# release: `release-sync.yml` sees `VERSION` change on `main`, waits for that
# commit's required checks, fast-forwards `release`, and hands off to
# `release.yml` to tag the commit and create the GitHub Release.
#
# Merge the PR however you like. Squash and merge-commit both leave the bump
# on `main`, and `release` fast-forwards to whatever `main`'s tip then is, so
# nothing downstream depends on the merge method.
#
# VERSION holds the release ordinal the account menu shows ("v28"). It is a
# tracked file because nothing can derive it at build time — Render's build
# gets RENDER_GIT_COMMIT and no tags, and release.yml creates the CalVer tag
# only after the deploy has started. This script computes the next ordinal,
# so it can no longer be forgotten or mistyped; the old guard that refused a
# release when VERSION had not moved is obsolete, because the bump and the
# release are now the same act.
#
# The commit subject names ONE release number, deliberately. Render's deploy
# list flattens subject and body onto a single line, so a message naming both
# the new and the previous release reads as two versions at once against the
# live deploy. What the previous release shipped belongs in the PR
# description, which this script writes.
#
# The bump commit is built with git plumbing and pushed straight to its own
# branch, so the working tree and the checked-out branch are never touched —
# safe to run from any worktree, including one with uncommitted work.
#
# Dry-run by default — prints the PR it would open. Pass --commit to open it.
#
# Usage:
#   bin/cut-release            # dry run: print the version, tickets and body
#   bin/cut-release --commit   # push the branch and open the release PR
#
# Requires git and gh, both authenticated against a push-authorised `origin`.

set -euo pipefail

COMMIT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --commit) COMMIT=1 ;;
        *)
            echo "Usage: $0 [--commit]" >&2
            exit 64  # EX_USAGE
            ;;
    esac
    shift
done

echo "Fetching origin (branches + tags)…"
git fetch origin --tags --quiet

if ! git rev-parse --verify --quiet origin/main >/dev/null; then
    echo "Error: origin/main not found." >&2
    exit 1
fi

if ! git rev-parse --verify --quiet origin/release >/dev/null; then
    echo "Error: origin/release not found. It is created once, by hand, at a" >&2
    echo "       known-good main commit; this script only ever advances it." >&2
    exit 1
fi

MAIN_SHA="$(git rev-parse origin/main)"

# `release` must be reachable from `main`, or the sync workflow's push is not
# a fast-forward and the ruleset will reject it. A non-fast-forward means
# someone advanced `release` out of band; refuse rather than force anything.
if ! git merge-base --is-ancestor origin/release origin/main; then
    echo "Error: origin/release is not an ancestor of origin/main — the" >&2
    echo "       release advance would not be a fast-forward. Reconcile" >&2
    echo "       release with main before releasing." >&2
    exit 1
fi

if [[ "$(git rev-parse origin/release)" == "$MAIN_SHA" ]]; then
    echo "origin/release already equals origin/main — nothing to release."
    exit 0
fi

read_version() {
    # `git show ref:path` fails when the file is absent on that ref; an
    # unreadable side is reported by the caller, not swallowed here.
    git show "${1}:VERSION" 2>/dev/null | tr -d '[:space:]' || true
}

RELEASE_VERSION="$(read_version origin/release)"
MAIN_VERSION="$(read_version origin/main)"

if [[ ! "$RELEASE_VERSION" =~ ^[0-9]+$ ]]; then
    echo "Error: origin/release:VERSION does not hold a release ordinal" >&2
    echo "       (it reads '${RELEASE_VERSION}'). Fix it before releasing." >&2
    exit 1
fi

# main and release must agree before a release opens. When they differ, a
# release PR has already merged and the sync has not completed — opening a
# second one would skip an ordinal and race the first push to `release`.
if [[ "$MAIN_VERSION" != "$RELEASE_VERSION" ]]; then
    echo "Error: VERSION reads ${MAIN_VERSION} on main and ${RELEASE_VERSION} on release." >&2
    echo "       A release is already in flight. Wait for the Release sync" >&2
    echo "       workflow to finish, or check whether it failed:" >&2
    echo "         gh run list --workflow release-sync.yml" >&2
    exit 1
fi

NEXT=$((RELEASE_VERSION + 1))
# `release-vNN`, not `release/vNN`: git cannot hold both `refs/heads/release`
# and `refs/heads/release/vNN`, so the slashed form fails at push time with
# "cannot lock ref … 'refs/heads/release' exists".
BRANCH="release-v${NEXT}"

if git rev-parse --verify --quiet "origin/${BRANCH}" >/dev/null; then
    echo "Error: origin/${BRANCH} already exists — v${NEXT} has an open" >&2
    echo "       release PR, or a previous attempt left the branch behind." >&2
    exit 1
fi

RANGE="origin/release..origin/main"
COMMIT_COUNT="$(git rev-list --count "$RANGE")"

# One line per ticket, carrying that ticket's own commit subject, so the PR
# description reads as the release note rather than a list of ids.
#
# Prefer a subject that *opens* with the ticket id, which is the commit
# convention (`SNOW-xxx: …`). Matching anywhere would pick a merge commit
# that happens to name three tickets — repeating one line under each of them
# — or a `Merge pull request #768 from …/fix/SNOW-781-…` whose branch name
# mentions the ticket while its subject says nothing useful.
SUBJECTS="$(git log "$RANGE" --format='%s')"
TICKETS="$(printf '%s\n' "$SUBJECTS" | grep -oE 'SNOW-[0-9]+' | sort -u -t- -k2 -n || true)"
TICKET_LINES=""
if [[ -n "$TICKETS" ]]; then
    while read -r ticket; do
        [[ -z "$ticket" ]] && continue
        subject="$(printf '%s\n' "$SUBJECTS" | grep -m1 -E "^${ticket}[[:punct:]]" || true)"
        [[ -z "$subject" ]] && subject="$(printf '%s\n' "$SUBJECTS" | grep -m1 -F "$ticket" || true)"
        TICKET_LINES+="- ${subject:-$ticket}"$'\n'
    done <<<"$TICKETS"
else
    TICKET_LINES="- (no SNOW tickets found in range)"$'\n'
fi

COMMIT_MSG="Bump VERSION to ${NEXT} for the next production release

Merging this opens release v${NEXT}: it moves the ordinal the account menu
shows, and the Release sync workflow then fast-forwards \`release\` to
\`main\`, deploying production and tagging the commit.

The tickets this release ships are listed in the pull request.

Co-Authored-By: Claude <noreply@anthropic.com>"

PR_TITLE="Release v${NEXT}"
PR_BODY="Ships **v${NEXT}** to production — ${COMMIT_COUNT} commits on \`main\` that
production has not yet seen.

Merging this PR *is* the release. It bumps \`VERSION\` to ${NEXT}, and
[\`release-sync.yml\`](.github/workflows/release-sync.yml) then waits for this
commit's required checks on \`main\`, fast-forwards \`release\` to it, and hands
off to [\`release.yml\`](.github/workflows/release.yml) to tag the commit and
create the GitHub Release. Squash or merge-commit both work.

## Tickets in this release

${TICKET_LINES}
🤖 Generated with [Claude Code](https://claude.com/claude-code)"

echo
echo "Release:      v${RELEASE_VERSION} → v${NEXT}"
echo "Target:       ${MAIN_SHA:0:12}  (origin/main, ${COMMIT_COUNT} commits ahead of release)"
echo "Branch:       ${BRANCH}"
echo
echo "── pull request ─────────────────────────────────────────────"
echo "${PR_TITLE}"
echo
echo "${PR_BODY}"
echo "─────────────────────────────────────────────────────────────"
echo

if [[ "$COMMIT" -eq 0 ]]; then
    echo "DRY RUN — nothing pushed. Pass --commit to open this PR."
    exit 0
fi

# Build the bump commit without touching the working tree: write the new
# blob, splice it into a throwaway index seeded from main's tree, and commit
# that tree directly onto the main tip. `-S` is explicit because commit-tree
# does not honour commit.gpgsign, and `main` requires signed commits. The
# author is Claude and the committer is whoever runs this, per CLAUDE.md.
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

BLOB="$(printf '%s\n' "$NEXT" | git hash-object -w --stdin)"
export GIT_INDEX_FILE="${TMP_DIR}/index"
git read-tree "$MAIN_SHA"
git update-index --cacheinfo "100644,${BLOB},VERSION"
TREE="$(git write-tree)"
unset GIT_INDEX_FILE

NEW_COMMIT="$(
    GIT_AUTHOR_NAME="Claude" \
    GIT_AUTHOR_EMAIL="noreply@anthropic.com" \
    git commit-tree -S "$TREE" -p "$MAIN_SHA" -m "$COMMIT_MSG"
)"

echo "Pushing ${NEW_COMMIT:0:12} to ${BRANCH}…"
git push origin "${NEW_COMMIT}:refs/heads/${BRANCH}" --quiet

echo "Opening the release PR…"
gh pr create \
    --base main \
    --head "$BRANCH" \
    --title "$PR_TITLE" \
    --body "$PR_BODY"

echo
echo "Merge it when you are ready to ship. Production deploys on the merge."
