</style>

<div class="layout" id="top">
  <header class="masthead">
    <div class="masthead-inner">
      <p class="eyebrow">Snowdesk · manual QA</p>
      <h1>Test run</h1>
      <p class="standfirst">Every manual scenario for the bulletin site, the map, accounts, the PWA shell and offline downloads — with the dev-server links live, so you can work down a scenario with the app open beside it.</p>
      <p class="meta">
        <span>{scenario_count} scenarios</span>
        <span>Rendered {generated:%-d %B %Y}</span>
        <span>Source: docs/testing-scenarios.md</span>
      </p>
      {render_environment()}
    </div>
  </header>

  <aside class="rail">
    <h2>Index</h2>
    {index}
  </aside>

  <main>
{body}
  </main>
</div>
"""


def build() -> tuple[str, int]:
    """Render the document.

    Returns:
        The page HTML and the number of scenarios it holds.

    """
    markdown = strip_frontmatter(SOURCE.read_text(encoding="utf-8"))
    md = MarkdownIt("commonmark").enable("table").enable("strikethrough")
    tokens = md.parse(markdown)
    entries = anchor_headings(tokens)

    rendered = md.renderer.render(tokens, md.options, {})
    rendered = defuse_repo_links(rendered)
    rendered = linkify(rendered)
    rendered = rendered.replace("<table>", '<div class="table-wrap"><table>').replace(
        "</table>", "</table></div>"
    )
    # A way back to the index from every scenario, without a floating control
    # over a page that is mostly tables.
    rendered = re.sub(
        r'(<h3 id="([^"]+)">)(.*?)(</h3>)',
        lambda m: (
            f'{m.group(1)}{m.group(3)}<a class="top" href="#top" aria-label="Back to the index">index ↑</a>{m.group(4)}'
        ),
        rendered,
        flags=re.DOTALL,
    )

    # Drop the document's own H1 — the masthead carries it.
    rendered = re.sub(r"<h1[^>]*>.*?</h1>", "", rendered, count=1, flags=re.DOTALL)

    scenarios = sum(1 for entry in entries if entry.level == 3 and entry.label)
    return page(rendered, render_index(entries), scenarios, dt.date.today()), scenarios


def main() -> int:
    """Entry point.

    Returns:
        Process exit code.

    """
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--output",
        type=pathlib.Path,
        help="write the page here instead of stdout",
    )
    args = parser.parse_args()

    rendered, scenarios = build()
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
        print(f"wrote {args.output} — {scenarios} scenarios", file=sys.stderr)
    else:
        print(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
