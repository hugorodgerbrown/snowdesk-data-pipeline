#!/usr/bin/env python3
# bin/render-testing-scenarios — render the manual test script as a page.
#
# docs/testing-scenarios.md is a working document: someone opens it, works
# down a scenario, and keeps a browser beside it. Read as markdown that is
# awkward — sixty-odd scenarios in one file, no way to jump between them,
# and every http://localhost:8000 URL in it has to be copied by hand.
#
# This renders the same file as one navigable page: an index of every
# section and scenario, an anchor on every heading, and every localhost URL
# turned into a link you can click while the dev server is running.
#
# The markdown stays the source of truth. Nothing here is authored — the
# page is a projection of the file, so a scenario edited there and not
# re-rendered shows up as a stale page rather than as a page that quietly
# disagrees with the document.
#
# The output is a self-contained HTML fragment — no <!doctype>, <html>,
# <head> or <body> of its own — the same convention as
# bin/render-day-summary-matrix, docs/page-audits/ and docs/research/, so it
# publishes as an Artifact and still renders opened straight from disk.
#
# Reads only. Prints to stdout unless --output names a file.
#
#     uv run python bin/render-testing-scenarios --output /tmp/scenarios.html
#
# ruff: noqa: T201, E501
# T201 — CLI script; print() is the intended output channel.
# E501 — most of this file is an embedded HTML document. Rewrapping its
#        markup and CSS to 88 columns to satisfy a Python line-length rule
#        would damage the output for no reader's benefit, which is the same
#        reasoning bin/render-day-summary-matrix's header gives.

"""Manual test-script renderer — see the header block above for full behaviour."""

from __future__ import annotations

import argparse
import datetime as dt
import html
import pathlib
import re
import sys
from dataclasses import dataclass

from markdown_it import MarkdownIt
from markdown_it.token import Token

REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCE = REPO_ROOT / "docs" / "testing-scenarios.md"

# The dev-server URLs the script sends a tester to often enough to be worth
# a permanent strip at the top. Each one is checked into the document or
# into CLAUDE.md; none is invented here.
ENVIRONMENT_LINKS: list[tuple[str, str, str]] = [
    ("Map (home)", "http://localhost:8000/", "the page most scenarios start on"),
    (
        "Bulletin",
        "http://localhost:8000/ch-4115/martigny-verbier/2026-04-08/",
        "the canonical preview bulletin",
    ),
    (
        "Account settings",
        "http://localhost:8000/account/settings/",
        "sign-out, passkeys, Reset local data",
    ),
    ("Mailpit", "http://localhost:8025/", "every outbound email in dev"),
    ("Components", "http://localhost:8000/_components/", "the design-system reference"),
    ("SW version", "http://localhost:8000/_sw-version/", "deployed vs live worker"),
]

# "### Scenario P12: Reset local data (settings page button)" — the document's
# own vernacular. The id becomes the anchor and the chip; the rest is the title.
SCENARIO_HEADING = re.compile(r"^Scenario\s+([A-Za-z]*\d+[a-z]?):\s*(.+)$")

# A bare URL in running text. The document writes dev-server URLs unlinked
# (`Navigate to http://localhost:8000/account/settings/`), which is the form
# a reader of the markdown wants and a reader of this page does not.
BARE_URL = re.compile(r"https?://[^\s<>()\[\]{}\"']+[^\s<>()\[\]{}\"'.,;:]")

# Splits rendered HTML into tags and the text between them.
TAG_SPLIT = re.compile(r"(<[^>]+>)")


@dataclass(frozen=True)
class Entry:
    """One index entry — a section (level 2) or a scenario (level 3)."""

    level: int
    anchor: str
    label: str
    title: str


def slugify(text: str) -> str:
    """Reduce heading text to a URL-safe anchor.

    Args:
        text: The heading's plain-text content.

    Returns:
        A lowercase, hyphen-separated slug.

    """
    slug = re.sub(r"[^\w\s-]", "", text.lower())
    return re.sub(r"[\s_]+", "-", slug).strip("-")


def strip_frontmatter(text: str) -> str:
    """Drop the YAML frontmatter block docs-lint requires on every doc.

    Args:
        text: The raw markdown file contents.

    Returns:
        The markdown body, frontmatter removed.

    """
    if not text.startswith("---\n"):
        return text
    end = text.find("\n---\n", 4)
    return text if end == -1 else text[end + 5 :]


def anchor_headings(tokens: list[Token]) -> list[Entry]:
    """Give every heading a stable id and collect the index entries.

    A scenario heading is anchored on its id (``scenario-p12``) rather than
    its full title, so an anchor survives the title being reworded.

    Args:
        tokens: The parsed markdown token stream, modified in place.

    Returns:
        The level-2 and level-3 entries, in document order.

    """
    entries: list[Entry] = []
    seen: dict[str, int] = {}

    for index, token in enumerate(tokens):
        if token.type != "heading_open":
            continue
        content = tokens[index + 1].content
        match = SCENARIO_HEADING.match(content)
        label, title = (match.group(1), match.group(2)) if match else ("", content)
        base = slugify(f"scenario-{label}" if label else content) or "section"
        seen[base] = seen.get(base, 0) + 1
        anchor = base if seen[base] == 1 else f"{base}-{seen[base]}"
        token.attrSet("id", anchor)

        level = int(token.tag[1:])
        if level in (2, 3):
            entries.append(Entry(level=level, anchor=anchor, label=label, title=title))

    return entries


def linkify(rendered: str) -> str:
    """Turn bare URLs in the rendered HTML into links.

    Only the text between tags is touched, and never inside an anchor or a
    code span — a URL already linked must not be linked twice, and one shown
    as code is being quoted rather than offered.

    Args:
        rendered: The HTML markdown-it produced.

    Returns:
        The same HTML with bare URLs wrapped in anchors.

    """
    out: list[str] = []
    depth = 0

    for part in TAG_SPLIT.split(rendered):
        if part.startswith("<"):
            name = part.lstrip("</").split(" ", 1)[0].rstrip(">")
            if name in ("a", "code", "pre"):
                depth += -1 if part.startswith("</") else 1
            out.append(part)
        elif depth > 0 or not part.strip():
            out.append(part)
        else:
            out.append(
                BARE_URL.sub(
                    lambda m: (
                        f'<a class="url" href="{m.group(0)}" target="_blank" rel="noopener">{m.group(0)}</a>'
                    ),
                    part,
                )
            )

    return "".join(out)


def defuse_repo_links(rendered: str) -> str:
    """Render repo-relative links as code rather than as dead anchors.

    The document links to source files (``../tests/js/test_sw.js``) and to
    sibling docs. Neither resolves from a standalone page, and a link that
    goes nowhere is worse than a path the reader can copy.

    Args:
        rendered: The HTML markdown-it produced.

    Returns:
        The same HTML with off-site relative anchors replaced by code spans.

    """

    def replace(match: re.Match[str]) -> str:
        href, text = match.group(1), match.group(2)
        if href.startswith(("http://", "https://", "#", "mailto:")):
            return match.group(0)
        return f'<code class="path">{text}</code>'

    return re.sub(
        r'<a href="([^"]+)"[^>]*>(.*?)</a>', replace, rendered, flags=re.DOTALL
    )


def render_index(entries: list[Entry]) -> str:
    """Build the navigation rail from the collected headings.

    Args:
        entries: The index entries, in document order.

    Returns:
        The index markup.

    """
    rows: list[str] = []
    open_section = False

    for entry in entries:
        if entry.level == 2:
            if open_section:
                rows.append("</ul></li>")
            rows.append(
                f'<li class="nav-section"><a href="#{entry.anchor}">{html.escape(entry.title)}</a><ul>'
            )
            open_section = True
            continue

        if not open_section:
            rows.append('<li class="nav-section"><ul>')
            open_section = True

        chip = (
            f'<span class="chip">{html.escape(entry.label)}</span>'
            if entry.label
            else ""
        )
        rows.append(
            f'<li class="nav-scenario"><a href="#{entry.anchor}">{chip}<span>{html.escape(entry.title)}</span></a></li>'
        )

    if open_section:
        rows.append("</ul></li>")

    return f'<ul class="nav-list">{"".join(rows)}</ul>'


def render_environment() -> str:
    """Build the dev-server link strip.

    Returns:
        The environment strip markup.

    """
    cards = "".join(
        f'<a class="env-card" href="{url}" target="_blank" rel="noopener">'
        f'<span class="env-name">{html.escape(name)}</span>'
        f'<span class="env-url">{html.escape(url.replace("http://", ""))}</span>'
        f'<span class="env-note">{html.escape(note)}</span></a>'
        for name, url, note in ENVIRONMENT_LINKS
    )
    return f'<nav class="env" aria-label="Dev server links">{cards}</nav>'


def page(body: str, index: str, scenario_count: int, generated: dt.date) -> str:
    """Assemble the complete HTML fragment.

    Args:
        body: The rendered document.
        index: The navigation rail markup.
        scenario_count: How many scenarios the document holds.
        generated: The date this render was made.

    Returns:
        A self-contained HTML fragment.

    """
    return f"""<title>Snowdesk Test Run</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap">
