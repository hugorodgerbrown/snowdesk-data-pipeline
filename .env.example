DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite in development)
DATABASE_URL=sqlite:///db.sqlite3

# SLF CAAML API — no credentials required (public API)

# Default start date for fetch_bulletins (season build-up backstop).
# Override per-environment if you need an earlier backfill window.
SEASON_START_DATE=2025-11-01

# Account-access token lifetime in seconds (default: 86400 = 24 hours).
# ACCOUNT_TOKEN_MAX_AGE=86400

# Base URL used when building absolute links outside a request context.
SITE_BASE_URL=http://localhost:8000

# SNOW-399: environment label used to distinguish the staging PWA install
# from production. Default is "production" — any other value (e.g.
# "staging") swaps the manifest name, theme colour, and icon set so both
# installs can coexist on a device without visually colliding. Set to
# "staging" on the Render staging service.
SITE_ENVIRONMENT=production

# Move outbound email onto a daemon thread so SMTP latency does not block
# the request (default: True).  Set to False to dispatch synchronously,
# which is useful when debugging the local mail backend.
SUBSCRIPTIONS_EMAIL_ASYNC=True

# Email — local dev defaults to Mailpit on localhost:1025 (no auth, no TLS).
# Production uses Resend's SMTP relay:
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=<your Resend API key>
#   EMAIL_USE_TLS=True
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

DEFAULT_FROM_EMAIL=noreply@snowdesk.ch

# Trusted CSRF origins — required in production (comma-separated https:// URLs).
# Must include every hostname that submits forms to this Django app.
# CSRF_TRUSTED_ORIGINS=https://snowdesk.info,https://www.snowdesk.info

# WebAuthn / Passkeys
# RP_ID must exactly match the deployed domain (no port, no scheme).
# ORIGIN must be the full https:// origin.  Both default to localhost for dev.
# WEBAUTHN_RP_ID=snowdesk.info
# WEBAUTHN_RP_NAME=Snowdesk
# WEBAUTHN_ORIGIN=https://snowdesk.info

# Open-Meteo — weather (fetch_weather) and elevation (link_resort_forecast_points).
# Unset means the free public hosts, whose per-IP quota (600/min, 5,000/hour,
# 10,000/day) is shared across the elevation, forecast, and archive endpoints.
# The key is only ever sent to a host moved off its free default, so the two
# hosts can sit on different tiers — set the archive host and the key alone
# for a historical pull, and daily forecast traffic stays free and unkeyed.
# OPEN_METEO_API_KEY=
# OPEN_METEO_API_BASE_URL=https://customer-api.open-meteo.com/v1
# OPEN_METEO_ARCHIVE_BASE_URL=https://customer-archive-api.open-meteo.com/v1

# Whether the scheduled fetch_weather run also retains ForecastPointWeatherHistory
# rows (SNOW-575) — this issue's view of each forecast day, kept for future
# convergence analysis. Nothing user-facing reads it, so it is off by default.
# Read at fire time: flip it on the snowdesk-scheduler service and restart to
# turn retention on or off without a deploy.
# FETCH_WEATHER_ADD_HISTORY=True

# MeteoFrance APIM — required for fetch_bulletins --source meteofrance in production.
# Obtain a key from https://portail-api.meteofrance.fr/
# METEOFRANCE_API_KEY=

# For local testing without an API key, point at a directory of sample XMLs.
# Use an absolute path with the three-slash file:// form so the URL parses
# the same regardless of the working directory the management command is run
# from:
# METEOFRANCE_API_LOCAL_MIRROR_URL=file:///absolute/path/to/bulletins/local_mirrors/meteofrance

# PostHog analytics — server-side event capture.
# Leave unset (or empty) to disable analytics entirely (no events sent).
# In production set to the EU project API key.
# POSTHOG_API_KEY=phc_your_project_api_key_here
# Set to False to stop PosthogContextMiddleware capturing unhandled view exceptions.
# POSTHOG_MW_CAPTURE_EXCEPTIONS=True
# Set to False to capture exception stack traces without frame-local variables
# (default True ships frame-locals to PostHog, redacted by built-in patterns).
# POSTHOG_CAPTURE_EXCEPTION_CODE_VARIABLES=True

# PWA telemetry master switch (default True). Set to False to silence the
# whole first-party PWA telemetry pipeline — static/js/telemetry.js becomes
# an inert no-op (no buffering, no sendBeacon, no /api/telemetry POSTs), the
# receiver accepts-and-drops, and the server-emitted signals no-op. Handy for
# quietening telemetry when running locally. See docs/telemetry-pipeline.md.
# PWA_TELEMETRY_ENABLED=False

# MaxMind GeoLite2-City database — used to resolve client IP to country/city.
# Obtain a free account at https://www.maxmind.com/en/geolite2/signup, then
# run `bin/fetch-geoip-data` to download the database. Leave empty to skip
# download (local dev without an account boots fine; geo fields will be empty).
# See data/geoip/README.md for full setup instructions.
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# Web Push (VAPID) — required for /_push-demo/ and future subscriber notifications.
# Generate the keypair with: python manage.py mint_vapid_keypair --commit
# See docs/push-notifications.md for the full setup guide.
#
# The secret-file content is the raw 32-byte private scalar as a single-line
# URL-safe-base64 string (43 chars), NOT a PEM. This dodges a py_vapid 1.9
# parser bug — see the doc's Troubleshooting section.
# VAPID_PUBLIC_KEY=<87-char URL-safe-base64 uncompressed P-256 point>
# VAPID_CLAIM_EMAIL=mailto:ops@yourdomain.com
# VAPID_PRIVATE_KEY_PATH=.vapid-private.key

# Map — basemap style JSON URL consumed by MapLibre on /map/.
# BASEMAP selects a key from the BASEMAP_STYLES catalogue in
# config/settings/base.py (default: openfreemap_liberty). An unknown key
# raises at startup.
# BASEMAP=openfreemap_liberty

# OpenFreeMap Liberty basemap origin (SNOW-242) — env-configurable so the
# basemap can move to a self-hosted origin (SNOW-485) without a code
# deploy. The CSP connect-src origin is derived from this same value.
# OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Slope-angle raster overlay (SNOW-691) — swisstopo's
# ch.swisstopo.hangneigung-ueber_30 WMTS layer as an XYZ template. Zoom 0-17
# only (z18 answers HTTP 400). Env-configurable so a replacement raster can
# be swapped in without a deploy; the CSP connect-src/img-src origin is
# derived from this same value.
# SLOPE_TILE_URL=https://wmts.geo.admin.ch/1.0.0/ch.swisstopo.hangneigung-ueber_30/default/current/3857/{z}/{x}/{y}.png

# Forced update (SNOW-609) — comma-separated build identifiers the server
# refuses to keep serving. A client whose X-Client-Version is a member gets
# update_required: true from /api/version and a non-dismissable modal.
# Values are APP_VERSION build ids (git SHAs on Render), never ranges —
# there is no minimum-version floor, because SHAs have no order. Empty (the
# default) blocks nobody. Blocking is an env-var change on the Render
# dashboard, not a deploy; deploy the fix first, then block the bad build.
# See docs/decisions/blocked-builds-not-a-version-floor.md.
# APP_BLOCKED_VERSIONS=
