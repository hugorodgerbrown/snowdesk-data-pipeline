{
  "autocompact_percentage_override": 75,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000"
  },
  "permissions": {
    "allow": [
      "Bash(python3 -c ':*)",
      "Bash(git commit -m ':*)",
      "Bash(git log *)",
      "Bash(pre-commit run *)",
      "Bash(sqlite3 db.sqlite3:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://127.0.0.1*)",
      "Bash(open http://localhost*)",
      "Bash(mkdir -p ~/.claude/logs/project-update)",
      "Write(~/.claude/logs/project-update/*)",

      "WebFetch(domain:aws.slf.ch)",
      "WebFetch(domain:caaml.org)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",

      "Skill(implement)",
      "Skill(implement:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",

      "mcp__linear-server__*",
      "mcp__render__*",

      "mcp__bee16520-0a2b-446d-b267-fbf9f62cf3a8__*",
      "mcp__f5febe82-aeb9-4554-8972-72e0c42f00ec__*"
    ],
    "deny": [
      "Read(./.venv/**)",
      "Read(./node_modules/**)",
      "Read(./__pycache__/**)",
      "Read(**/__pycache__/**)",
      "Read(**/*.egg-info/**)",
      "Read(./.lighthouseci/**)",
      "Read(./logs/**)",
      "Read(./static/css/output.css)",
      "Read(./.tox/**)",
      "Read(./htmlcov/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.ruff_cache/**)",
      "Read(./.mypy_cache/**)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",

      "mcp__*__trigger_deploy",
      "mcp__*__update_environment_variables",
      "mcp__*__create_web_service",
      "mcp__*__create_static_site",
      "mcp__*__create_cron_job",
      "mcp__*__create_postgres",
      "mcp__*__create_key_value"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bin/setup-remote-env 2>&1 || true"
          },
          {
            "type": "command",
            "command": "bin/init-worktree 2>&1 || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bin/mark-worktree-cleanable 2>&1 || true"
          }
        ]
      }
    ]
  }
}
